                                    </span>
                                </a>
                                <ul class="navbar-mobile-sub__list list-unstyled js-sub-list">
                                    <li>
                                        <a href="~/Module/Module"><i class="zmdi zmdi-apps zmdi-hc-lg"></i> Module</a>
                                    </li>
                                    <li>
                                        <a href="~/Module/Action"><i class="zmdi zmdi-accounts-list-alt zmdi-hc-lg"></i> Action</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="has-sub">
                                <a class="js-arrow" href="#" style="color:@(ViewBag.Page == "Users"||ViewBag.Page == "User Profile" ? "royalblue" : "")">
