                                    <i class="fas fa-angle-down"></i>
                                </span>
                            </a>
                            <ul class="navbar-mobile-sub__list list-unstyled js-sub-list">
                                <li>
                                    <a href="~/Distributor/Distributor"><i class="fas fa-truck"></i>Distributor</a>
                                </li>
                                <li>
                                    <a href="~/Distributor/DistributonArea"><i class="zmdi zmdi-map zmdi-hc-lg"></i> Distributon Area</a>
                                </li>
                            </ul>
                        <li>
                            <a href="~/Reseller/Reseller">
