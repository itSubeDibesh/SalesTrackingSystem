                                    <i class="fas fa-angle-down"></i>
                                </span>
                            </a>
                            <ul class="navbar-mobile-sub__list list-unstyled js-sub-list">
                                <li>
                                    <a href="~/Products/Batch"><i class="fas fa-sitemap"></i> Batch</a>
                                </li>
                                <li>
                                    <a href="~/Products/Products"><i class="zmdi zmdi-shopping-basket zmdi-hc-lg"></i> Products</a>
                                </li>
                            </ul>
