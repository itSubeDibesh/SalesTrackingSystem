@model Models.Users_Model
@using Models
@{
    var SessionVariable = new Users_Model();
    if (Session["auth"] != null)
    {
        SessionVariable = (Session["auth"] as Users_Model);
    }
}
<!DOCTYPE html>
<noscript>
    <meta http-equiv="refresh" content="0;url=https://@Request.ServerVariables["HTTP_HOST"]/Error/J404">
</noscript>
@{ViewBag.AppName = "Tinjure tea factory";}
<html lang="en">
<head>
    <!-- Required meta tags-->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Salse tracking system by idebus.co">
    <meta name="author" content="Idebus.co.np">
    <meta name="keywords" content="Sales Tracking System">

    <!-- Title Page-->
    <title>@ViewBag.Title | @ViewBag.AppName</title>
    <link rel="icon" href="~/Images/icon/favicon.png" type="image">
    @Styles.Render("~/bundles/css")
    @RenderSection("style", required: false)

</head>

<body>
    <div class="page-wrapper">
        <!-- HEADER MOBILE-->
