            <div class="logo">
                <a href="~/Home/Index">
                    <img src="~/images/icon/logo.png" alt="Tinjure tea factory" />
                </a>
            </div>
            <div class="menu-sidebar2__content js-scrollbar1">
                <nav class="navbar-sidebar2">
                    <ul class="list-unstyled navbar__list">
                        <li class="@(ViewBag.Page == "Home" ? "active" : " ")">
                            <a href="~/Home/Index">
                                <i class="zmdi zmdi-home zmdi-hc-lg"></i>Home
                            </a>
                        </li>
                        <li class="@(ViewBag.Page == "Dashboard" ? "active" : " ")">
                            <a href="~/Home/Dashboard"><i class="fas fa-chart-line"></i> Dashboard</a>
                        </li>                       
                        <li class="has-sub @(ViewBag.Page == "Distributor"||ViewBag.Page == "Distributon Area" ? "active" : " ")">
                            <a class="js-arrow" href="#">
                                <i class="zmdi zmdi-store zmdi-hc-lg"></i>Distribution
                                <span class="arrow">
                                    <i class="fas fa-angle-down"></i>
                                </span>
                            </a>
                            <ul class="list-unstyled navbar__sub-list js-sub-list">
                                <li>
                                    <a href="~/Distributor/Distributor"><i class="fas fa-truck"></i>Distributor</a>
                                </li>
                                <li>
                                    <a href="~/Distributor/DistributonArea"><i class="zmdi zmdi-map zmdi-hc-lg"></i> Distributon Area</a>
                                </li>
                            </ul>
                        </li>
                        <li class="@(ViewBag.Page == "Reseller" ? "active" : " ")">
                            <a href="~/Reseller/Reseller">
                                <i class="zmdi zmdi-store-24 zmdi-hc-lg"></i>Reseller
                            </a>
                        </li>
                        @if (SessionVariable.ProfileName == "Developer" && SessionVariable.UserProfileStatus == true)
                        {
                            <li class="has-sub @(ViewBag.Page == "Module"||ViewBag.Page == "Action" ? "active" : " ")">
                                <a class="js-arrow" href="#">
                                    <i class="zmdi zmdi-view-module zmdi-hc-lg"></i>Modules
                                    <span class="arrow">
                                        <i class="fas fa-angle-down"></i>
                                    </span>
                                </a>
                                <ul class="list-unstyled navbar__sub-list js-sub-list">
                                    <li>
                                        <a href="~/Module/Module"><i class="zmdi zmdi-apps zmdi-hc-lg"></i> Module</a>
                                    </li>
                                    <li>
                                        <a href="~/Module/Action"><i class="zmdi zmdi-accounts-list-alt zmdi-hc-lg"></i> Action</a>
                                    </li>
                                </ul>
                            </li>
                            <li class="has-sub @(ViewBag.Page == "Users"||ViewBag.Page == "User Profile" ? "active" : " ")">
                                <a class="js-arrow" href="#">
                                    <i class="zmdi zmdi-accounts zmdi-hc-lg"></i>User
                                    <span class="arrow">
                                        <i class="fas fa-angle-down"></i>
                                    </span>
                                </a>
                                <ul class="list-unstyled navbar__sub-list js-sub-list">
                                    <li>
                                        <a href="~/User/Userprofile"><i class="zmdi zmdi-folder-person zmdi-hc-lg"></i> User Profile</a>
                                    </li>
                                    <li>
                                        <a href="~/User/Users"><i class="zmdi zmdi-accounts-list zmdi-hc-lg"></i> Users</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="@(ViewBag.Page == "Users" ? "active" : " ")">
