                        <li>
                            <a href="~/Transaction/Transaction">
                                <i class="zmdi zmdi-file-text zmdi-hc-lg" style="color:@(ViewBag.Page == "Transaction" ? "royalblue" : "")"></i>Transaction
                            </a>
                        </li>
                        <li class="has-sub">
