                            <a href="~/Home/Index" style="color:@(ViewBag.Page == "Home" ? "royalblue" : "")">
                                <i class="zmdi zmdi-home zmdi-hc-lg"></i>Home
                            </a>
                        </li>
                        <li>
                            <a href="~/Home/Dashboard" style="color:@(ViewBag.Page == "Dashboard" ? "royalblue" : "")">
                                <i class="fas fa-chart-line"></i>Dashboard
                            </a>
                        </li>                       
                        <li>
                        <li class="has-sub">
                            <a class="js-arrow" href="#" style="color:@(ViewBag.Page == "Distributor"||ViewBag.Page == "Distributon Area" ? "royalblue" : "")">
