                            </a>
                        </li>
                        @if (SessionVariable.ProfileName == "Developer" && SessionVariable.UserProfileStatus == true)
                        {
                            <li class="has-sub">
                                <a class="js-arrow" href="#" style="color:@(ViewBag.Page == "Module"||ViewBag.Page == "Action" ? "royalblue" : "")">
                                    <i class="zmdi zmdi-view-module zmdi-hc-lg"></i>Modules
