                        </li>
                        <li class="has-sub  @(ViewBag.Page == "Products"||ViewBag.Page == "Batch" ? "active" : " ")">
                            <a class="js-arrow" href="#">
                                <i class="zmdi zmdi-shopping-cart zmdi-hc-lg"></i>Products
                                <span class="arrow">
                                    <i class="fas fa-angle-down"></i>
                                </span>
                            </a>
                            <ul class="list-unstyled navbar__sub-list js-sub-list">
                                <li>
                                    <a href="~/Products/Batch"><i class="fas fa-sitemap"></i> Batch</a>
                                </li>
                                <li>
