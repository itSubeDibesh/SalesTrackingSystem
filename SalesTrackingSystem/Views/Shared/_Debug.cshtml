@using Models
@if (ViewBag.ServerDebug!=null)
{
    <div class="container bg-warning " style="color:black;font-size:large;">
        <div class="card">
            <div class="card-content">
                <div class="card-title m-3">Server Debugger</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            methord =>@Request.RequestType
                            <pre>
                            <code>                  
                    @for (int i = 0; i < Request.Params.AllKeys.Length; i++)
                    {
                            <pre> @Request.Params.Keys.Get(i).Substring(0) => @Request.Params.Get(Request.Params.Keys.Get(i)).Substring(0)</pre>
                    }
                </code>
            </pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ViewBag.ServerInfo!=null)
{
    <div class="container bg-warning " style="color:black;font-size:large;">
        <div class="card">
            <div class="card-content">
                <div class="card-title m-3">Server Information</div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-12">
                            <pre>
                                @ServerInfo.GetHtml()
                            </pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ViewBag.UserInfo!=null)
{
    var Ses = (Session["auth"] as Users_Model);
    <p>UserID : @Ses.UserID</p>
    <p>UserProfileID : @Ses.UserProfileID</p>
    <p>VerificationID : @Ses.VerificationID</p>
    <p>DistrubitorID : @Ses.DistrubitorID</p>
    <p>CreatedBy : @Ses.CreatedBy</p>
    <p>DateCreated : @Ses.DateCreated</p>
    <p>DateUpdated : @Ses.DateUpdated</p>
    <p>DateVerified : @Ses.DateVerified</p>
    <p>Description : @Ses.Description</p>
    <p>Email : @Ses.Email</p>
    <p>ExeceptionProfile : @Ses.ExeceptionProfile</p>
    <p>FullName : @Ses.FullName</p>
    <p>ImageString : @Ses.ImageString</p>
    <p>IsVerified : @Ses.IsVerified</p>
    <p>MobileNo : @Ses.MobileNo</p>
    <p>PasswordHash : @Ses.PasswordHash</p>
    <p>ProfileName : @Ses.ProfileName</p>
    <p>ResetToken : @Ses.ResetToken</p>
    <p>ResetTriggered : @Ses.ResetTriggered</p>
    <p>Token : @Ses.Token</p>
    <p>UserProfileStatus : @Ses.UserProfileStatus</p>
    <p>UsersStatus : @Ses.UsersStatus</p>
    <p>VerifiedToken : @Ses.VerifiedToken</p>
}