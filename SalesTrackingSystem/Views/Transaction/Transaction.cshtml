@using Services.Interface
@using Services.Service
@using Models;
@{
    Transaction_Interface transaction = new Transaction_Service();
    Users_Interface user = new Users_Service();
    Distributor_Interface distributor_ = new Distributor_Service();
    Reseller_Interface reseller = new Reseller_Service();
    Product_Interface product = new Product_Service();
    Batch_Interface batch = new Batch_Service();

    var TransacctionVariable = new Transaction_Model();
    if (Session["Transaction"] != null)
    {
        TransacctionVariable = (Session["Transaction"] as Transaction_Model);
    }
}

@{
    ViewBag.Title = "Transaction";
    ViewBag.Page = "Transaction";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.AppName = "Tinjure tea factory";
    int SearialNumber = 1;
    int SearialNumberInvoice = 1;
    int SearialNumberInvoicePrint = 1;
    ViewBag.Action = "Add";
}
@Html.Partial("~/Views/Shared/_Alert.cshtml")
<div class="row">
    <div class="col-12">
        <div class="overview-wrap">
            <div class="title-1">
                <h4><a href="">@ViewBag.AppName</a> > @ViewBag.Page</h4>
            </div>
        </div>
        <br>
    </div>
</div>
<!--#region Forms-->
@if (ViewBag.AddError != null)
{
    <script>
        window.onload = function () {
            $('#AddTransaction').slideDown();
        }
    </script>
}

<div class="row">

    @if (ViewBag.Action == "Add")
    {
        @Html.Partial("AddTransaction")
    }

    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <strong>  Transaction List</strong>
                <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" data-placement="right" title="Add transaction" onclick="javascript: $('#AddTransaction').slideDown()">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="table dynamic-table-action table-bordered table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th style="text-align: center;">SN</th>
                            <th style="text-align: center;">Supplier Name</th>
                            <th style="text-align: center;">Receiver Name</th>
                            <th style="text-align: center;">Invoice No</th>
                            <th style="text-align: center;">Entry Date</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in transaction.DisplayTable())
                        {
                            if (item != null)
                            {
                                <tr>
                                    <td style="text-align: center;">@(SearialNumber++)</td>
                                    <td style="text-align: center;">
                                        @if (item.TransactionLevel == 1)/*Distributor to Reseller*/
                                        {
                                            var SupplierPrimaryInfo = user.GetModelById(item.SupplierID);
                                            var SupplierDetails = distributor_.GetDistributorById(Convert.ToInt64(SupplierPrimaryInfo.DistrubitorID));
                                            if (SupplierDetails != null)
                                            {
                                                <span>@SupplierDetails.DistrubitorName</span>
                                            }
                                        }
                                        else/*Company to Distributor*/
                                        {
                                            <span> Tinjure Organic Tea</span>
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        @if (item.TransactionLevel == 1)/*Distributor to Reseller*/
                                        {
                                            var resellerInfo = reseller.GetResellerById(item.ReceiverID);
                                            <span>@resellerInfo.ResellerName</span>
                                        }
                                        else/*Company to Distributor*/
                                        {
                                            var ReceiverPrimaryInfo = user.GetModelById(item.ReceiverID);
                                            var ReceiverDetails = new Distributor_Model();
                                            if (ReceiverPrimaryInfo != null)
                                            {
                                                ReceiverDetails = distributor_.GetDistributorById(Convert.ToInt64(ReceiverPrimaryInfo.DistrubitorID));
                                            }

                                            if (ReceiverDetails != null)
                                            {
                                                <span>@ReceiverDetails.DistrubitorName</span>
                                            }
                                        }
                                    </td>
                                    <td style="text-align: center;">@item.InvoiceNo</td>
                                    <td style="text-align: center;">@(string.Format("{0:dd/MM/yyyy}", item.InvoiceEntryDate))</td>
                                    <td style="padding-left:3.5%;">
                                        <button class="btn btn-success" onclick="setTransaction(@item.TransactionID)" data-toggle="modal" id="InvoiceTargete" data-target="#InvoicePopup"><i class="fas fa-eye" style="color:white;"></i> View</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
