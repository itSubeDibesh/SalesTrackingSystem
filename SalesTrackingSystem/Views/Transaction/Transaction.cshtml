@section scripts{
    <script>
        $(function () {
            $('.dynamic-scroable-table-module').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                paging: false,
                "searching": false,
                "bPaginate": false,
                "bLengthChange": false,
                "bFilter": false,
                "bInfo": false,
            });
        });
        $(function () {
            $('.dynamic-table-action').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                responsive: true,
                lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ],
                drawCallback: function (e) {
                    var t = this.api(),
                        l = t.rows({
                            page: "current"
                        }).nodes(),
                        c = null;
                    t.column(1, {
                        page: "current"
                    }).data().each(function (e, t) {
                        c !== e && ($(l).eq(t).before('<tr class="group"><td colspan="5">' + e + "</td></tr>"), c = e)
                    })
                }
            });
        });

        function printDiv(divName) {
            var printContents = document.getElementById(divName).innerHTML;
            var originalContents = document.body.innerHTML;
            document.body.innerHTML = printContents;
            window.print();
            document.body.innerHTML = originalContents;
        }

         $("body").on("click", "#btnAdd", function () {
            //Reference the Name and Country TextBoxes.
            var ProductID = $("#ProductID");
            var Quantity = $("#Quantity");

            //Get the reference of the Table's TBODY element.
            var tBody = $("#tableTransactionDetails > TBODY")[0];

            //Add Row.
            var row = tBody.insertRow(-1);

            //Add ProductID cell.
            var cell = $(row.insertCell(-1));
            cell.html(ProductID.val());

            //Add Quantity cell.
            cell = $(row.insertCell(-1));
            cell.html(Quantity.val());

            //Add Button cell.
            cell = $(row.insertCell(-1));
            var btnRemove = $("<button class='btn btn-danger btn-sm'> <i class='fas fa-minus'> Remove</button>");
            btnRemove.attr("type", "button");
            btnRemove.attr("onclick", "Remove(this);");
            cell.append(btnRemove);

            //Clear the TextBoxes.
            ProductID.val("");
            Quantity.val("");
        });

        function Remove(button) {
            //Determine the reference of the Row using the Button.
            var row = $(button).closest("TR");
            var name = $("TD", row).eq(0).html();
            //Get the reference of the Table.
            var table = $("#tableTransactionDetails")[0];
            //Delete the Table row using it's Index.
            table.deleteRow(row[0].rowIndex);
        };

        $("body").on("click", "#AddTransactionAjax", function () {
            //Loop through the Table rows and build a JSON array.
            var transaction = {};
            transaction.TransactionLevel = $("#TransactionLevel").val();
            transaction.SupplierID = $("#SupplierID").val();
            transaction.ReceiverID = $("#ReceiverID").val();
            transaction.InvoiceNo = $("#InvoiceNo").val();
            transaction.InvoiceDate = $("#InvoiceDate").val();
            transaction.DiscountPercent = $("#DiscountPercent").val();
            transaction.TaxPercent = $("#TaxPercent").val();
            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/Transaction/TransactionAdd",
                data: JSON.stringify(transaction),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                        var transactionDetail = new Array();
                        $("#tableTransactionDetails TBODY TR").each(function () {
                            var row = $(this);
                            var AddTransDetail = {};
                            AddTransDetail.TransactionID = response;
                            AddTransDetail.ProductID = row.find("TD").eq(0).html();
                            AddTransDetail.Quantity = row.find("TD").eq(1).html();
                            AddTransDetail.DateCreated = "@(DateTime.Now)";
                            transactionDetail.push(AddTransDetail);
                        });
                        $.ajax({
                        type: "POST",
                        url: "/Transaction/TransactionDetailsAdd",
                        data: JSON.stringify(transactionDetail),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                            success: function () {
                                location.reload();
                            }
                    });
                }
            });
        });

        function setTransaction(id) {
            var data = {};
            data.TID = id;
             $.ajax({
                type: "POST",
                url: "/Transaction/TransactionView",
                data: JSON.stringify(data),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                 success: function () {
                }
            });

        }

        $('[data-toggle=modal]').on('click', function (e) {
            var $target = $($(this).data('target'));
            $target.data('triggered',true);
            setTimeout(function() {
                if ($target.data('triggered')) {
                    $target.modal('show').data('triggered',false);
                };
            }, 1000); // milliseconds
            return false;
        });
    </script>
}


