@model Models.Users_Model

@{
    ViewBag.Title = "Distributor";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Page = "Distributor";
    ViewBag.AppName = "Tinjure tea factory";
    ViewBag.Action = "AddDistributor";
    var SerialNumber = 1;
}
@using Services.Interface;
@using Services.Service;
@{
    Distributor_Interface dist = new Distributor_Service();
}
@Html.Partial("~/Views/Shared/_Alert.cshtml")
<div class="row">
    <div class="col-12">
        <div class="overview-wrap">
            <div class="title-1">
                <h4><a href="">@ViewBag.AppName</a> > Distribution > @ViewBag.Page</h4>
            </div>
        </div>
        <br>
    </div>
</div>
<div class="row">
    @if (ViewBag.AddDistributor != null)
    {
        <script>
            window.onload = function () {
                $('#AddDistributor').slideDown();
            }
        </script>
    }
    @if (ViewBag.DistriutorUpdateError != null)
    {
        <script>
            window.onload = function () {
                $('#EditDistributor').slideDown();
            }
        </script>
    }
    @*Add Update Distributor*@
    @if (ViewBag.Action == "AddDistributor")
    {
        @Html.Partial("AddDistributor")
    }
    @if (Request.Params.Get("action") == "UpdateDistributor")
    {
        if (dist.DistributorExist(Convert.ToInt64(Request.Params.Get("dist"))))
        {
            @Html.Partial("EditDistributor", dist.GetDistributorById(Convert.ToInt64(Request.Params.Get("dist"))));
        }
        else
        {
            Session["Error"] = " Distributor couldn't be found please retry!!";
        }
    }
    @if (ViewBag.UpdateDistributorData != null)
    {
        Int64 distId = Convert.ToInt64(ViewBag.UpdateDistribuotrData);
        if (dist.DistributorExist(distId))
        {
            @Html.Partial("EditDistributor", dist.GetDistributorById(distId));
        }
        else
        {
            Session["Error"] = " Distributor couldn't be found please retry!!";
        }
    }
    @*Add Update Distributor Ends*@
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <strong> Distributors List</strong>
                <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" onclick="$('#AddDistributor').slideDown();" data-placement="left" title="Add distributor">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="dynamic-table table table-bordered table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th style="text-align: center;">SN</th>
                            <th style="text-align: center;">Distributor Name</th>
                            <th style="text-align: center;">Owner Name</th>
                            <th style="text-align: center;">Mobile No</th>
                            <th style="text-align: center;">Phone No</th>
                            <th style="text-align: center;">Fax</th>
                            <th style="text-align: center;">Email</th>
                            <th style="text-align: center;">Address</th>
                            <th style="text-align: center;">State</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in dist.DisplayTable())
                        {
                            if (item!=null)
                            {
                                <tr>
                                    <td style="text-align: center;">@(SerialNumber++)</td>
                                    <td style="text-align: center;">@item.DistrubitorName</td>
                                    <td style="text-align: center;">@item.OwnerName</td>
                                    <td style="text-align: center;">@item.MobileNo</td>
                                    <td style="text-align: center;">@item.Phone</td>
                                    <td style="text-align: center;">@item.Fax</td>
                                    <td style="text-align: center;">@item.Email</td>
                                    <td style="text-align: center;">@item.Address</td>
                                    <td style="text-align: center;"> @item.State</td>
                                    <td>
                                        <a href="~/Distributor/EditDistributor?action=UpdateDistributor&dist=@item.DistrubitorID"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                        <a href="#" onclick="DeleteAndNotify(@item.DistrubitorID,'@item.DistrubitorName')"><i class="fas fa-trash" style="color:red;" data-toggle="tooltip" data-placement="right" title="Delete"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>

        $(function () {
            $('.dynamic-table').DataTable({
                responsive: true,
                lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ],

            });
        });
        function DeleteAndNotify(id, value) {
            swal({
                title: "Are you sure?",
                text: "You want to delete " + value + " , all the related data will be deleted!",
                icon: "warning",
                closeOnEsc: false,
                closeOnClickOutside: false,
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        var data = {};
                        data.DistrubitorID = id;
                        data.DistrubitorName = value;
                        $.ajax({
                            type: "POST",
                            url: "/Distributor/DeleteDistributor",
                            dataType: "json",
                            data: JSON.stringify(data),
                            contentType: "application/json; charset=utf-8",
                            success: function (response) {
                                swal("Poof all gone! " + response, {
                                    icon: "success",
                                }).then(function () {
                                    window.location.href = "/Distributor/Distributor"
                                });
                            },
                            failure: function (response) {
                                alert(response.responseText);
                            },
                            error: function (response) {
                                alert(response.responseText);
                            }
                        });
                    }
                });
        }
    </script>
}