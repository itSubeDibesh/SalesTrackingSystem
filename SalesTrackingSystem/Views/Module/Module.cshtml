@model Models.Module_Model

@{
    ViewBag.Title = "Module";
    ViewBag.Page = "Module";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.AppName = "Tinjure tea factory";
}

<div class="row">
    <div class="col-12">
        <div class="overview-wrap">
            <div class="title-1">
                <h4><a href="">@ViewBag.AppName</a> > Modules > @ViewBag.Title</h4>
            </div>
        </div>
        <br>
    </div>
</div>
<!--#region Forms-->
<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <strong>Add</strong> Module
                <button class="btn btn-danger " style="float: right;" data-toggle="tooltip" data-placement="right" title="Close Module">
                    <i class="fas fa-close"></i>
                </button>
            </div>
            <div class="card-body card-block">
                <form action="" method="post" enctype="multipart/form-data" class="form-horizontal">
                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            <label for="text-input" class=" form-control-label">Module Name</label>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <input type="text" id="text-input" name="text-input" placeholder="Text" class="form-control">
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <label for="text-input" class=" form-control-label">Controller Name</label>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <input type="text" id="text-input" name="text-input" placeholder="Text" class="form-control">
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            <label for="select" class=" form-control-label">Module Status</label>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="select" id="select" class="form-control">
                                <option selected disabled>Please select</option>
                                <option value="1">Active</option>
                                <option value="2">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col col-md-3">
                            <label for="textarea-input" class=" form-control-label">Description</label>
                        </div>
                        <div class="col-12 col-md-9">
                            <textarea name="textarea-input" id="textarea-input" rows="15" placeholder="Content..." class="form-control"></textarea>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="fa fa-paper-plane"></i> Submit
                        </button>
                        <button type="reset" class="btn btn-primary btn-sm">
                            <i class="fa fa-trash"></i> Reset
                        </button>
                        <button type="reset" class="btn btn-danger btn-sm">
                            <i class="fa fa-close"></i> Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <strong> Module List</strong>
                <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" data-placement="right" title="Add Module">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="table dynamic-scroable-table-module table-bordered table-hover">
                    <thead class="thead-dark">
                    <th style="text-align: center;">SN</th>
                    <th style="text-align: center;">Module Name</th>
                    <th style="text-align: center;">Controller Name</th>
                    <th style="text-align: center;">Module Status</th>
                    <th style="text-align: center;">Action</th>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="text-align: center;">1</td>
                            <td style="text-align: center;">Login</td>
                            <td style="text-align: center;">Login</td>
                            <td style="text-align: center; color:green;"> @*<i class="fas <?php echo " active"= ="active" ?"fa-thumbs-up":"fa-thumbs-down"?>"></i>*@ Active</td>
                            <td style="padding-left:15%;">
                                <a href="#"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                <a href="#"><i class="fas fa-trash" style="color:red;" data-toggle="tooltip" data-placement="right" title="Delete"></i></a>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: center;">2</td>
                            <td style="text-align: center;">Validation</td>
                            <td style="text-align: center;">Login</td>
                            <td style="text-align: center; color:red;"> @*<i class="fas <?php echo " inactive"= ="active" ?"fa-thumbs-up":"fa-thumbs-down"?>"></i>*@ Inactive</td>
                            <td style="padding-left:15%;">
                                <a href="#"><i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                <a href="#"><i class="fas fa-trash" style="color:red;" data-toggle="tooltip" data-placement="right" title="Delete"></i></a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!--#endregion Forms ends-->
@section scripts{
    <script>
        $(function () {
            $('.dynamic-scroable-table-module').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                paging: !1,
                "searching": false,
                "bPaginate": false,
                "bLengthChange": false,
                "bFilter": true,
                "bInfo": false,
                "bAutoWidth": false
            });
        });
    </script>
}