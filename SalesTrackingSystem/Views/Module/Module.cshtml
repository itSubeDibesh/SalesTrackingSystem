@using Services.Interface
@using Services.Service
@using Models;
@{
    Module_Interface Module_ = new Module_Service();
}

@{
    ViewBag.Title = "Module";
    ViewBag.Page = "Module";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.AppName = "Tinjure tea factory";
    int SearialNumber = 1;
    ViewBag.ActionName = "Add";
}
@Html.Partial("~/Views/Shared/_Alert.cshtml")
<div class="row">
    <div class="col-12">
        <div class="overview-wrap">
            <div class="title-1">
                <h4><a href="~/Home/Index">@ViewBag.AppName</a> > Modules > @ViewBag.Title</h4>
            </div>
        </div>
        <br>
    </div>
</div>
<!--#region Forms-->
@if (ViewBag.AddError != null)
{
    <script>
        window.onload = function () {
            $('#ModuleAdd').slideDown();
        }
    </script>
}
@if (ViewBag.EditDropDown != null)
{
    <script>
        window.onload = function () {
            $('#ModuleUpdate').slideDown();
        }
    </script>
}
@if (ViewBag.UpdateError != null)
{
    <script>
        window.onload = function () {
            $('#ModuleUpdate').slideDown();
        }
    </script>
}
<div class="row">

    @if (ViewBag.ActionName == "Add")
    {
        @Html.Partial("Module_Add")
    }

    @if (Request.Params.Get("action") == "Update")
    {
        if (Module_.ModuleExists(Convert.ToInt64(Request.Params.Get("uaid"))))
        {
            @Html.Partial("Module_Update", Module_.ModuleByID(Convert.ToInt64(Request.Params.Get("uaid"))));
        }
        else
        {
            Session["Error"] = " Module couldn't be found please retry!!";
        }
    }

    @if (ViewBag.UpdateData != null)
    {
        Int64 uaid = Convert.ToInt64(ViewBag.UpdateData);
        if (Module_.ModuleExists(uaid))
        {
            @Html.Partial("Module_Update", Module_.ModuleByID(uaid));
        }
        else
        {
            Session["Error"] = " Module couldn't be found please retry!!";
        }
    }

    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <strong> Module List</strong>
                <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" data-placement="right" title="Add Module" onclick="javascript: $('#ModuleAdd').slideDown()">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="table dynamic-scroable-table-module table-bordered table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th style="text-align: center;">SN</th>
                            <th style="text-align: center;">Module Name</th>
                            <th style="text-align: center;">Controller Name</th>
                            <th style="text-align: center;">Module Status</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ModuleItem in Module_.DisplayTable())
                        {
                            if (Module_.DisplayTable() != null)
                            {
                                <tr>
                                    <td style="text-align: center;">@(SearialNumber++)</td>
                                    <td style="text-align: center;">@ModuleItem.ModuleName</td>
                                    <td style="text-align: center;">@ModuleItem.ControllerName</td>
                                    <td style="text-align: center; color:@(ModuleItem.ModuleStatus==true?"green":"red");"> <i class="fas @(ModuleItem.ModuleStatus==true ?"fa-thumbs-up":"fa-thumbs-down")"></i> @(ModuleItem.ModuleStatus == true ? "Enabled" : "Disabled")</td>
                                    <td style="padding-left:15%;">
                                        <a href="~/Module/ModuleEdit?action=Update&uaid=@ModuleItem.ModuleID"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                        <a href="#" onclick="DeleteAndNotify(@ModuleItem.ModuleID,'@ModuleItem.ModuleName')"><i class="fas fa-trash" style="color:red;"></i></a>
                                    </td>
                                </tr>
                            }

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!--#endregion Forms ends-->
@section scripts{
    <script>
        $(function () {
            $('.dynamic-scroable-table-module').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                paging: !1,
                "searching": false,
                "bPaginate": false,
                "bLengthChange": false,
                "bFilter": true,
                "bInfo": false,
                "bAutoWidth": false
            });
        });

         function DeleteAndNotify(id, value) {           
            swal({
                title: "Are you sure?",
                text: "You want to delete " + value + " Module, all the related data will be deleted!",
                icon: "warning",
                closeOnEsc: false,
                closeOnClickOutside :false,
                buttons: true,
                dangerMode: true,
                })
                .then((willDelete) => {
                    if (willDelete) {
                        var data = {};
                        data.ModuleID = id;
                        data.ModuleName = value;
                        $.ajax({
                            type: "POST",
                            url: "/Module/ModuleDelete",
                            dataType:"json",
                            data: JSON.stringify(data),
                            contentType: "application/json; charset=utf-8",
                            success: function (response) {
                                swal("Poof all gone! " + response, {
                                    icon: "success",
                                }).then(function () {
                                    window.location.href = "/Module/Module"
                                });
                            },
                            failure: function (response) {
                                alert(response.responseText);
                            },
                            error: function (response) {
                                alert(response.responseText);
                            }
                        });
                    }                   
                });
        }
    </script>
}