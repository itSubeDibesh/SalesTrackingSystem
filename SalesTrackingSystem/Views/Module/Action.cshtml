<!--#endregion Forms ends-->
@section scripts{
    <script>
        $(function () {
            $('.dynamic-table-action').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                responsive: true,
                lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ],
                drawCallback: function (e) {
                    var t = this.api(),
                        l = t.rows({
                            page: "current"
                        }).nodes(),
                        c = null;
                    t.column(1, {
                        page: "current"
                    }).data().each(function (e, t) {
                        c !== e && ($(l).eq(t).before('<tr class="group"><td colspan="5">' + e + "</td></tr>"), c = e)
                    })
                }
            });
        });

        function showModule() {
            $('#moduleId').show();
        }
    </script>
}


