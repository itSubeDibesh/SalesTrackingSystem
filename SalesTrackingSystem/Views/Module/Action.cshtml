@using Services.Interface
@using Services.Service
@using Models;

@{
    ModuleAction_Interface moduleAction_ = new ModuleAction_Service();
}

@model Models.ModuleAction_Model

@{
    ViewBag.Title = "Action";
    ViewBag.Page = "Action";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.AppName = "Tinjure tea factory";
    int SearialNumber = 1;
    ViewBag.ActionName = "Add";
}
@Html.Partial("~/Views/Shared/_Alert.cshtml")
<div class="row">
    <div class="col-12">
        <div class="overview-wrap">
            <div class="title-1">
                <h4><a href="">@ViewBag.AppName</a> > Modules > @ViewBag.Page</h4>
            </div>
        </div>
        <br>
    </div>
</div>
<!--#region Forms-->
@if (ViewBag.AddError != null)
{
    <script>
        window.onload = function () {
            $('#ActionAdd').slideDown();
        }
    </script>
}
@if (ViewBag.EditDropDown != null)
{
    <script>
        window.onload = function () {
            $('#ActionUpdate').slideDown();
        }
    </script>
}
@if (ViewBag.UpdateError != null)
{
    <script>
        window.onload = function () {
            $('#ActionUpdate').slideDown();
        }
    </script>
}
<div class="row">
    @if (ViewBag.ActionName == "Add")
    {
        @Html.Partial("Action_Add")
    }

    @if (Request.Params.Get("action") == "Update")
    {
        if (moduleAction_.ActionExists(Convert.ToInt64(Request.Params.Get("uaid"))))
        {
            @Html.Partial("Action_Update", moduleAction_.ActionByID(Convert.ToInt64(Request.Params.Get("uaid"))));
        }
        else
        {
            Session["Error"] = " Action couldn't be found please retry!!";
        }
    }

    @if (ViewBag.UpdateData != null)
    {
        Int64 uaid = Convert.ToInt64(ViewBag.UpdateData);
        if (moduleAction_.ActionExists(uaid))
        {
            @Html.Partial("Action_Update", moduleAction_.ActionByID(uaid));
        }
        else
        {
            Session["Error"] = " Action couldn't be found please retry!!";
        }
    }   
    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <strong> Module Action List</strong>
                <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" data-placement="right" title="Add Module Action" onclick="javascript: $('#ActionAdd').slideDown()">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="table dynamic-table-action table-bordered table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th style="text-align: center;">SN</th>
                            <th style="text-align: center;">Module Name</th>
                            <th style="text-align: center;">Action Name</th>
                            <th style="text-align: center;">Action Status</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ModuleActionItem in moduleAction_.DisplayTable())
                        {
                            if (moduleAction_.DisplayTable() != null)
                            {
                                <tr>
                                    <td style="text-align: center;">@(SearialNumber++)</td>
                                    <td style="text-align: center;">@ModuleActionItem.ModuleName</td>
                                    <td style="text-align: center;">@ModuleActionItem.ActionName</td>
                                    <td style="text-align: center; color:@(ModuleActionItem.ActionStatus==true?"green":"red");"> <i class="fas @(ModuleActionItem.ActionStatus==true ?"fa-thumbs-up":"fa-thumbs-down")"></i> @(ModuleActionItem.ActionStatus == true ? "Enabled" : "Disabled")</td>
                                    <td style="padding-left:5%;">
                                        <a href="~/Module/ActionEdit?action=Update&uaid=@ModuleActionItem.ModuleActionID"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                        <a href="javascript:void(0);" onclick="DeleteAndNotify(@ModuleActionItem.ModuleActionID,'@ModuleActionItem.ActionName')"><i class="fas fa-trash" style="color:red;"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!--#endregion Forms ends-->
@section scripts{
    <script>
        $(function () {
            $('.dynamic-table-action').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                responsive: true,
                lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ],
                drawCallback: function (e) {
                    var t = this.api(),
                        l = t.rows({
                            page: "current"
                        }).nodes(),
                        c = null;
                    t.column(1, {
                        page: "current"
                    }).data().each(function (e, t) {
                        c !== e && ($(l).eq(t).before('<tr class="group"><td colspan="5">' + e + "</td></tr>"), c = e)
                    })
                }
            });
        });

        function DeleteAndNotify(id, value) {           
            swal({
                title: "Are you sure?",
                text: "You want to delete " + value + " Action, all the related data will be deleted!",
                icon: "warning",
                closeOnEsc: false,
                closeOnClickOutside :false,
                buttons: true,
                dangerMode: true,
                })
                .then((willDelete) => {
                    if (willDelete) {
                        var data = {};
                        data.ModuleActionID = id;
                        data.ActionName = value;
                        $.ajax({
                            type: "POST",
                            url: "/Module/ActionDelete",
                            dataType:"json",
                            data: JSON.stringify(data),
                            contentType: "application/json; charset=utf-8",
                            success: function (response) {
                                swal("Poof all gone! " + response, {
                                    icon: "success",
                                }).then(function () {
                                    window.location.href = "/Module/Action"
                                });
                            }
                        });
                    }                   
                });
        }
    </script>
}


