@model Models.ProductCategory_Model
@using Services.Interface
@using Services.Service
@{
    ProductCategory_Interface productCategory = new ProductCategory_Service();
}<div class="col-sm-12 " id="EditProductCategory" style="display:block">
    <div class="card">
        <div class="card-header">
            <strong>Update</strong> Product Category
            <a href="~/Products/Products" class="btn btn-danger " style="float: right;color:white;" data-toggle="tooltip" data-placement="right" title="Close Edit ProductCategory Update"><i class="fas fa-close"></i></a>
        </div>
        <div class="card-body card-block">
            @using (Html.BeginForm("EditProductCategory", "Products", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.ProductCategoryID)
                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.ProductCategoryName, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.EditorFor(model => model.ProductCategoryName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ProductCategoryName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.IsSubCategory, htmlAttributes: new { @class = "form-control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.EditorFor(model => model.IsSubCategory, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.IsSubCategory, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            <label for="text-input" class=" form-control-label">Sub-Category Of</label>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="SubCategoryOf" id="SubCategoryOf" class="form-control">
                                <option selected disabled>Please select</option>
                                @foreach (var ModuleItem in productCategory.ListAllData())
                                {
                                    if (productCategory.ListAllData() != null)
                                    {
                                        <option value="@ModuleItem.ProductCategoryID" @(Model.ProductCategoryID == ModuleItem.ProductCategoryID ? "selected" : "")>@ModuleItem.ProductCategoryName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.CategoryStatus, htmlAttributes: new { @class = "form-control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.EditorFor(model => model.CategoryStatus, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.CategoryStatus, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="card-footer">
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="fa fa-paper-plane"></i> Submit
                        </button>
                        <button type="reset" class="btn btn-primary btn-sm">
                            <i class="fa fa-trash"></i> Reset
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>