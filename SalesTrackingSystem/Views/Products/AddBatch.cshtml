@model Models.Batch_Model
@using Services.Interface;
@using Services.Service;
@{
    Batch_Interface batchService = new Batch_Service();
    Product_Interface productService = new Product_Service();
    ProductCategory_Interface productCategoryService = new ProductCategory_Service();
}
<div class="col-sm-12 " id="AddBatch" style="display:block">
    <div class="card">
        <div class="card-header">
            <strong>Add</strong> @ViewBag.Page
            <button class="btn btn-danger " type="reset" style="float: right;" data-toggle="tooltip" data-placement="right" title="Close Batch" onclick="javascript:$('#AddBatch').slideUp()">
                <i class="fas fa-close"></i>
            </button>
        </div>
        <div class="card-body card-block">
            @using (Html.BeginForm("AddBatch", "Products", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.BatchName, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.EditorFor(model => model.BatchName, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.BatchName, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.ProductName, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="ProductID" id="select" class="form-control">
                                <option selected disabled>Please select</option>
                                @foreach (var item in productService.ListAllData())
                                {
                                    <option value="@item.ProductID">@item.ProductName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.ProductCategoryName, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="ProductCategoryId" id="select" class="form-control">
                                <option selected disabled>Please select</option>
                                @foreach (var item in productCategoryService.ListAllData())
                                {
                                    <option value="@item.ProductCategoryID">@item.ProductCategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.QunatityProduced, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.EditorFor(model => model.QunatityProduced, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                            @Html.ValidationMessageFor(model => model.QunatityProduced, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.UnitPrice, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.EditorFor(model => model.UnitPrice, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                            @Html.ValidationMessageFor(model => model.UnitPrice, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.StockLeft, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.EditorFor(model => model.StockLeft, new { htmlAttributes = new { @class = "form-control", @type = "number",@disabled="disabled" } })
                            @Html.ValidationMessageFor(model => model.StockLeft, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.DateProduced, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="row">
                                <div class="col-sm-10">
                                    <input type="text" value="" name="DateProduced" id="DateProduced" class="bod-picker form-control ">
                                </div>
                                <div class="col-sm-2">
                                    <a class="btn btn-danger" style="float: right;color:white;" id="clear-DateProduce" data-toggle="tooltip" data-placement="right" title="Clear">
                                        <i class="fas fa-close"></i>
                                    </a>
                                </div>
                            </div>
                            @Html.ValidationMessageFor(model => model.DateProduced, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.ExpiryDate, htmlAttributes: new { @class = "control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <div class="row">
                                <div class="col-sm-10">
                                    <input type="text" value="" id="ExpiryDate" name="ExpiryDate" class="bod-picker form-control ">
                                </div>
                                <div class="col-sm-2">
                                    <a class="btn btn-danger" style="float: right;color:white;" id="clear-ExpiryDate" data-toggle="tooltip" data-placement="right" title="Clear">
                                        <i class="fas fa-close"></i>
                                    </a>
                                </div>
                            </div>
                            @Html.ValidationMessageFor(model => model.ExpiryDate, "", new { @class = "text-danger" })

                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="fa fa-paper-plane"></i> Submit
                        </button>
                        <a href="~/Products/Products" class="btn btn-primary btn-sm">
                            <i class="fa fa-trash"></i> Reset
                        </a>
                    </div>

                </div>
            }
        </div>
    </div>
</div>