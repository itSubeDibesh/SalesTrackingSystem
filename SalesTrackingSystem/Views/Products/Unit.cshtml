@using Services.Interface
@using Services.Service
@using Models;
@model Unit_Model
@{
    ViewBag.Title = "Unit";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Page = "Unit";
    ViewBag.AppName = "Tinjure tea factory";
    int SearialNumber = 1;
    ViewBag.Action = "Add";
    Unit_Interface unit_ = new Unit_Service();
}

@Html.Partial("~/Views/Shared/_Alert.cshtml")

<div class="row">
    <div class="col-12">
        <div class="overview-wrap">
            <div class="title-1">
                <h4><a href="">@ViewBag.AppName</a> > Products > @ViewBag.Page</h4>
            </div>
        </div>
    </div>
    <br>
    <br>
</div>
<!--#region Forms-->

@if (ViewBag.AddUnitError != null)
{
    <script>
        window.onload = function () {
            $('#UnitAdd').slideDown();
        }
    </script>
}
@if (ViewBag.EditUnitDropDown != null)
{
    <script>
        window.onload = function () {
            $('#UnitUpdate').slideDown();
        }
    </script>
}
@if (ViewBag.UpdateUnitError != null)
{
    <script>
        window.onload = function () {
            $('#UnitUpdate').slideDown();
        }
    </script>
}
<div class="row">
    @if (ViewBag.Action == "Add")
    {
        @Html.Partial("Unit_Add")
    }

    @if (Request.Params.Get("action") == "UnitUpdate")
    {
        if (unit_.UnitExist(Convert.ToInt64(Request.Params.Get("uaid"))))
        {
            @Html.Partial("Unit_Update", unit_.GetUnitById(Convert.ToInt64(Request.Params.Get("uaid"))));
        }
        else
        {
            Session["Error"] = " Unit couldn't be found please retry!!";
        }
    }

    @if (ViewBag.UpdateUnitData != null)
    {
        Int64 uaid = Convert.ToInt64(ViewBag.UpdateUnitData);
        if (unit_.UnitExist(uaid))
        {
            @Html.Partial("Unit_Update", unit_.GetUnitById(uaid));
        }
        else
        {
            Session["Error"] = " Unit couldn't be found please retry!!";
        }
    }

    <div class="col-sm-12">
        <div class="card">
            <div class="card-header">
                <strong> Unit List</strong>
                <button class="btn btn-primary " style="float: right;" onclick="$('#UnitAdd').slideDown();">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="dynamic-table table table-bordered table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th style="text-align: center;">SN</th>
                            <th style="text-align: center;">Unit Name</th>          
                            <th style="text-align: center;">Unit</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in unit_.DisplayTable())
                        {
                            if (item != null)
                            {
                                <tr>
                                    <td style="text-align: center;">@(SearialNumber++)</td>
                                    <td style="text-align: center;">@item.UnitName</td>
                                    <td style="text-align: center;">@item.UnitAbb</td>                                    
                                    <td style="padding-left:12%;">
                                        <a href="~/Products/UnitEdit?action=UnitUpdate&uaid=@item.UnitId"> <i class="fas fa-edit" style="color:green;"></i></a> |
                                        <a href="#" onclick="DeleteAndNotify(@item.UnitId,'@item.UnitName')"><i class="fas fa-trash" style="color:red;"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!--#endregion Forms ends-->
@section scripts{
    <script>
        $(function () {
            $('.dynamic-table').DataTable({
                responsive: true,
                lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ],

            });
        });

         function DeleteAndNotify(id, value) {
            swal({
                title: "Are you sure?",
                text: "You want to delete " + value + " , all the related data will be deleted!",
                icon: "warning",
                closeOnEsc: false,
                closeOnClickOutside: false,
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        var data = {};
                        data.UnitId = id;
                        data.UnitName = value;
                        $.ajax({
                            type: "POST",
                            url: "/Products/UnitDelete",
                            dataType: "json",
                            data: JSON.stringify(data),
                            contentType: "application/json; charset=utf-8",
                            success: function (response) {
                                swal("Poof all gone! " + response, {
                                    icon: "success",
                                }).then(function () {
                                    window.location.href = "/Products/Unit"
                                });
                            },
                            failure: function (response) {
                                alert(response.responseText);
                            },
                            error: function (response) {
                                alert(response.responseText);
                            }
                        });
                    }
                });
        }
    </script>
}




