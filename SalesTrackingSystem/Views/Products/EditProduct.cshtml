@model Models.Products_Model
@using Services.Interface
@using Services.Service
@{
    Product_Interface productService = new Product_Service();
    ProductCategory_Interface productCategoryService = new ProductCategory_Service();
}
    <div class="col-sm-12 " id="EditProduct" style="display:block">
        <div class="card">
            <div class="card-header">
                <strong>Update</strong> Product
                <a href="~/Products/Products" class="btn btn-danger " style="float: right;color:white;" data-toggle="tooltip" data-placement="right" title="Close Edit Product Update"><i class="fas fa-close"></i></a>
            </div>
            <div class="card-body card-block">
                @using (Html.BeginForm("UpdateProduct", "Products", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.ProductID)

                        <div class="row form-group">
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.ProductCategoryID, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <select name="ProductCategoryID" id="ProductCategoryID" class="form-control">
                                    <option selected disabled>Please select</option>
                                    @foreach (var item in productService.ListAllData())
                                    {
                                        <option value="@item.ProductCategoryID" @(Model.ProductCategoryID == item.ProductCategoryID ? "selected" : "")>@item.ProductCategoryName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.ProductName, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.EditorFor(model => model.ProductName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.ProductName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.PackRate, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.EditorFor(model => model.PackRate, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.PackRate, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.PackSize, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.EditorFor(model => model.PackSize, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.PackSize, "", new { @class = "text-danger" })
                            </div>
                        </div>


                        <div class="row form-group">
                            <div class="col col-md-3">
                                @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-12 col-md-9">
                                @Html.TextAreaFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="card-footer">
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="fa fa-paper-plane"></i> Submit
                            </button>
                            <a href="~/Products/Products" class="btn btn-primary btn-sm">
                                <i class="fa fa-trash"></i> Reset
                            </a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>