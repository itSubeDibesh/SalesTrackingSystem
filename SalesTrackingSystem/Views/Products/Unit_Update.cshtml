@model Models.Unit_Model

    <div class="col-sm-12" id="UnitUpdate" style="display:none;">
        <div class="card">
            <div class="card-header">
                Update <strong>Unit</strong>
                <a href="~/Products/Unit" class="btn btn-danger " style="float: right;color:white;"><i class="fas fa-close"></i></a>
            </div>
            <div class="card-body">
                <div class="col-12">
                        @using (Html.BeginForm("UnitUpdate", "Products", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            @Html.HiddenFor(model => model.UnitId)
                            <div class="form-horizontal">
                                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                                <div class="row form-group">
                                    <div class="col-md-3 col-sm-6">
                                        @Html.LabelFor(model => model.UnitName, htmlAttributes: new { @class = "form-control-label" })
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        @Html.EditorFor(model => model.UnitName, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.UnitName, "", new { @class = "text-danger" })
                                    </div>

                                    <div class="col-md-3 col-sm-6">
                                        @Html.LabelFor(model => model.UnitAbb, htmlAttributes: new { @class = "form-control-label" })
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        @Html.EditorFor(model => model.UnitAbb, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.UnitAbb, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="row form-group">
                                    <div class="col-md-3 col-sm-6">
                                        @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "form-control-label" })
                                    </div>
                                    <div class="col-md-9 col-sm-6">
                                        @Html.TextAreaFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="card-footer">
                                    <button type="submit" class="btn btn-success btn-sm">
                                        <i class="fa fa-save"></i> Save
                                    </button>
                                    <a href="~/Products/Unit" class="btn btn-danger btn-sm" style="color:white;"><i class="fa fa-trash"></i> Reset</a>
                                </div>
                            </div>
                        }
                    </div>
            </div>
        </div>
    </div>