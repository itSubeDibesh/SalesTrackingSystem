@using Services.Interface
@using Services.Service
@using Models;

@{
    Module_Interface module_ = new Module_Service();
    ModuleAction_Interface moduleAction_ = new ModuleAction_Service();
    UserProfile_Interface userProfile_ = new UserProfile_Service();
}

@model Models.UserProfileDetails_Model
<div class="col-sm-12" id="UserProfileDetailsUpdate" style="display:none;">
    <div class="card">
        <div class="card-header">
            <strong>Update</strong> User Profile Details
            <a href="~/User/UserProfile" class="btn btn-danger " style="float: right;color:white;" data-toggle="tooltip" data-placement="right" title="Close update profile details"><i class="fas fa-close"></i></a>
        </div>
        <div class="card-body card-block">
            @using (Html.BeginForm("UserProfileDetailsUpdate", "User", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @Html.HiddenFor(model => model.UserProfileDetailID)
                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.UserProfileID, htmlAttributes: new { @class = "form-control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="UserProfileID" id="UserProfileID" class="form-control">
                                <option selected disabled>Please select</option>
                                @foreach (var UserProfileItem in userProfile_.DisplayTable())
                                {
                                    if (userProfile_.DisplayTable() != null)
                                    {
                                        <option value="@UserProfileItem.UserProfileID" @(Model.UserProfileID==UserProfileItem.UserProfileID?"selected":"") >@UserProfileItem.ProfileName</option>
                                    }
                                }
                            </select>
                            @Html.ValidationMessageFor(model => model.UserProfileID, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.ModuleID, htmlAttributes: new { @class = "form-control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="ModuleID" id="ModuleID" class="form-control">
                                <option selected disabled>Please select</option>
                                @foreach (var moduleItem in module_.DisplayTable())
                                {
                                    if (module_.DisplayTable() != null)
                                    {
                                        <option value="@moduleItem.ModuleID"  @(Model.ModuleID==moduleItem.ModuleID?"selected":"")>@moduleItem.ModuleName</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.ModuleActionID, htmlAttributes: new { @class = "form-control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="ModuleActionID" id="ModuleActionID" class="form-control">
                                @foreach (var moduleActionItem in moduleAction_.DisplayTable())
                                {
                                    if (moduleAction_.DisplayTable() != null)
                                    {
                                        <option value="@moduleActionItem.ModuleActionID"  @(Model.ModuleActionID==moduleActionItem.ModuleActionID?"selected":"")>@moduleActionItem.ModuleName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.LabelFor(model => model.ProfileDetailStatus, htmlAttributes: new { @class = "form-control-label" })
                        </div>
                        <div class="col-md-3 col-sm-6">
                            @Html.EditorFor(model => model.ProfileDetailStatus, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.ProfileDetailStatus, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row form-group">
                        <div class="col col-md-3">
                            @Html.LabelFor(model => model.Description, htmlAttributes: new { @class = "form-control-label" })
                        </div>
                        <div class="col-12 col-md-9">
                            @Html.TextAreaFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    @*<div class="form-group">
                            @Html.LabelFor(model => model.CreatedBy, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.CreatedBy, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.CreatedBy, "", new { @class = "text-danger" })
                            </div>
                        </div>*@

                    <div class="card-footer">
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="fa fa-save"></i> Save
                        </button>
                        <a href="~/User/UserProfile" class="btn btn-danger btn-sm" style="color:white;"><i class="fa fa-trash"></i> Reset</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
