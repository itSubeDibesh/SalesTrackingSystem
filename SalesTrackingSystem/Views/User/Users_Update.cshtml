@using Services.Interface
@using Services.Service
@using Models;

@{
    UserProfile_Interface userProfile_ = new UserProfile_Service();
    Distributor_Interface distributor_ = new Distributor_Service();
}

@model Models.Users_Model
<div class="col-sm-12" id="UsersUpdate" style="display:none;">
    <div class="card">
        <div class="card-header">
            Update <strong>User</strong>
            <a href="~/User/Users" class="btn btn-danger " style="float: right;color:white;"><i class="fas fa-close"></i></a>
        </div>
        <div class="card-body">
            <div class="col-12">

                @using (Html.BeginForm("UserUpdate", "User", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        @Html.HiddenFor(model => model.UserID)
                        <div class="row form-group">
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.FullName, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
                            </div>

                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.Email, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control"  } })
                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.MobileNo, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.EditorFor(model => model.MobileNo, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.MobileNo, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.UsersStatus, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <select name="UsersStatus" id="UsersStatus" class="form-control">
                                    <option disabled>Please select</option>
                                    <option @(Model.UsersStatus == 0 ? "selected" : "") value="0">Reset</option>
                                    <option @(Model.UsersStatus == 1 ? "selected" : "") value="1">Active</option>
                                    <option @(Model.UsersStatus == 2 ? "selected" : "") value="2">Inactive</option>
                                    <option @(Model.UsersStatus == 3 ? "selected" : "") value="3">Blocked</option>                           
                                </select>
                                @Html.ValidationMessageFor(model => model.UsersStatus, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="row form-group">
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.UserProfileID, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <select name="UserProfileID" id="UserProfileID" class="form-control">
                                    <option selected disabled>Please select</option>
                                    @foreach (var UserProfileItem in userProfile_.DisplayTable())
                                    {
                                        if (userProfile_.DisplayTable() != null)
                                        {
                                            <option value="@UserProfileItem.UserProfileID" @(Model.UserProfileID == UserProfileItem.UserProfileID ? "selected" : "")>@UserProfileItem.ProfileName</option>
                                        }
                                    }
                                </select>
                                @Html.ValidationMessageFor(model => model.UserProfileID, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.DistrubitorID, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <select name="DistrubitorID" id="DistrubitorID" class="form-control">
                                    <option selected disabled>Please select</option>
                                    @foreach (var DistributorItem in distributor_.DisplayTable())
                                    {
                                        if (distributor_.DisplayTable() != null)
                                        {
                                            <option value="@DistributorItem.DistrubitorID" @(Model.DistrubitorID == DistributorItem.DistrubitorID ? "selected" : "")>@DistributorItem.DistrubitorName</option>
                                        }
                                    }
                                </select>
                                @Html.ValidationMessageFor(model => model.DistrubitorID, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.ImageString, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <input type="file" id="file-input-max-fs" name="ImageString" class="dropify form-control-file" data-max-file-size="2M" data-allowed-file-extensions="jpg jpeg png">
                                <p for="ImageString">Image (2MB)</p>
                            </div>
                            @if (Model.ImageString != null)
                            {
                        <div class="col-md-3 col-sm-6">
                            <img src="https://@Request.ServerVariables["HTTP_HOST"]@Model.ImageString" style="max-height:200px; width:auto;" alt="@Model.FullName" />
                            <p>Previous Image</p>
                        </div>
                            }
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="fa fa-save"></i> Save
                            </button>
                            <a href="~/User/Users" class="btn btn-danger btn-sm" style="color:white;"><i class="fa fa-trash"></i> Reset</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

