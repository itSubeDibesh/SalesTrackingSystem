@using Services.Interface
@using Services.Service
@using Models;
@{
    UserProfileDetails_Interface userProfileDetails_ = new UserProfileDetails_Service();
    UserProfile_Interface userProfile_ = new UserProfile_Service();
}


@model Models.UserProfile_Model

@{
    ViewBag.Title = "User Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Page = "User Profile";
    ViewBag.AppName = "Tinjure tea factory";
    int SearialNumberProfile = 1;
    int SearialNumberProfileDetails = 1;
    ViewBag.ActionNameProfile = "Add";
    ViewBag.ActionNameProfileDetails = "Add";
}
@Html.Partial("~/Views/Shared/_Alert.cshtml")
<div class="row">
    <div class="col-12">
        <div class="overview-wrap">
            <div class="title-1">
                <h4><a href="~/Home/Index">@ViewBag.AppName</a> > User > @ViewBag.Page</h4>
            </div>
        </div>
        <br>
    </div>
</div>
@if (ViewBag.AddUserProfileError != null)
{
    <script>
        window.onload = function () {
            $('#UserProfileAdd').slideDown();
        }
    </script>
}

@if (ViewBag.EditUserProfileDropDown != null)
{
    <script>
        window.onload = function () {
            $('#UserProfileUpdate').slideDown();
        }
    </script>
}
@if (ViewBag.UpdateUserProfileError != null)
{
    <script>
        window.onload = function () {
            $('#UserProfileUpdate').slideDown();
        }
    </script>
}

@if (ViewBag.AddUserProfileDetailsError != null)
{
    <script>
        window.onload = function () {
            $('#UserProfileDetailsAdd').slideDown();
        }
    </script>
}

@if (ViewBag.EditUserProfileDetailsDropDown != null)
{
    <script>
        window.onload = function () {
            $('#UserProfileDetailsUpdate').slideDown();
        }
    </script>
}
@if (ViewBag.UpdateUserProfileDetailsError != null)
{
    <script>
        window.onload = function () {
            $('#UserProfileDetailsUpdate').slideDown();
        }
    </script>
}
<!--#region Forms-->
<div class="row">

    @if (ViewBag.ActionNameProfile == "Add")
    {
        @Html.Partial("UserProfile_Add")
    }

    @if (Request.Params.Get("action") == "UserProfileUpdate")
    {
        if (userProfile_.UserProfileExists(Convert.ToInt64(Request.Params.Get("uaid"))))
        {
            @Html.Partial("UserProfile_Update", userProfile_.UserProfilByID(Convert.ToInt64(Request.Params.Get("uaid"))));
        }
        else
        {
            Session["Error"] = " Profile couldn't be found please retry!!";
        }
    }

    @if (ViewBag.UpdateUserProfileData != null)
    {
        Int64 uaid = Convert.ToInt64(ViewBag.UpdateUserProfileData);
        if (userProfile_.UserProfileExists(uaid))
        {
            @Html.Partial("UserProfile_Update", userProfile_.UserProfilByID(uaid));
        }
        else
        {
            Session["Error"] = " Profile couldn't be found please retry!!";
        }
    }

    @if (ViewBag.ActionNameProfileDetails == "Add")
    {
        @Html.Partial("UserProfileDetails_Add")
    }


    @if (Request.Params.Get("action") == "UserProfileDetailsUpdate")
    {
        if (userProfileDetails_.UserProfileDetailsExists(Convert.ToInt64(Request.Params.Get("uaid"))))
        {
            @Html.Partial("UserProfileDetails_Update", userProfileDetails_.UserProfilDetailsByID(Convert.ToInt64(Request.Params.Get("uaid"))));
        }
        else
        {
            Session["Error"] = " Profile details couldn't be found please retry!!";
        }
    }

    @if (ViewBag.UpdateUserProfileDetailsData != null)
    {
        Int64 uaid = Convert.ToInt64(ViewBag.UpdateUserProfileDetailsData);
        if (userProfileDetails_.UserProfileDetailsExists(uaid))
        {
            @Html.Partial("UserProfileDetails_Update", userProfileDetails_.UserProfilDetailsByID(uaid));
        }
        else
        {
            Session["Error"] = " Profile details couldn't be found please retry!!";
        }
    }

    <!-- Forms ends -->
    <div class="col-sm-6">
        <div class="card">
            <div class="card-header">
                <strong> User Profile List</strong>
                <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" data-placement="left" title="Add user profile" onclick="javascript: $('#UserProfileAdd').slideDown()">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="dynamic-scroable-table-module table table-bordered table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th style="text-align: center;">SN</th>
                            <th style="text-align: center;">Profile Name</th>
                            <th style="text-align: center;">Profile Status</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var userProfileItem in userProfile_.DisplayTable())
                        {
                            if (userProfile_.DisplayTable() != null)
                            {
                                <tr>
                                    <td style="text-align: center;">@(SearialNumberProfile++)</td>
                                    <td style="text-align: center;">@userProfileItem.ProfileName</td>
                                    <td style="text-align: center; color:@(userProfileItem.UserProfileStatus==true?"green":"red");"> <i class="fas @(userProfileItem.UserProfileStatus==true ?"fa-thumbs-up":"fa-thumbs-down")"></i> @(userProfileItem.UserProfileStatus == true ? "Enabled" : "Disabled")</td>
                                    <td style="padding-left:10%;">
                                        <a href="~/User/UserProfileEdit?action=UserProfileUpdate&uaid=@userProfileItem.UserProfileID"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                        <a href="#" onclick="DeleteUseProfileAndNotify(@userProfileItem.UserProfileID,'@userProfileItem.ProfileName')"><i class="fas fa-trash" style="color:red;" data-toggle="tooltip" data-placement="right" title="Delete"></i></a>
                                    </td>
                                </tr>
                            }

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="card">
            <div class="card-header">
                <strong> Profile Details List</strong>
                <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" data-placement="left" title="Add user profile details" onclick="javascript: $('#UserProfileDetailsAdd').slideDown()">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="dynamic-table-action table table-bordered table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th style="text-align: center;">SN</th>
                            <th style="text-align: center;">Profile Name</th>
                            <th style="text-align: center;">Module Name</th>
                            <th style="text-align: center;">Module Action Name</th>
                            <th style="text-align: center;">Profile Status</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var userProfileDetailsItem in userProfileDetails_.DisplayTable())
                        {
                            if (userProfileDetails_.DisplayTable() != null)
                            {
                                <tr>
                                    <td style="text-align: center;">@(SearialNumberProfileDetails++)</td>
                                    <td style="text-align: center;">@userProfileDetailsItem.ProfileName</td>
                                    <td style="text-align: center;">@userProfileDetailsItem.ModuleName</td>
                                    <td style="text-align: center;">@userProfileDetailsItem.ActionName</td>
                                    <td style="text-align: center; color:@(userProfileDetailsItem.ProfileDetailStatus==true?"green":"red");"> <i class="fas @(userProfileDetailsItem.ProfileDetailStatus==true ?"fa-thumbs-up":"fa-thumbs-down")"></i> @(userProfileDetailsItem.ProfileDetailStatus == true ? "Enabled" : "Disabled")</td>
                                    <td style="padding-left:4%;">
                                        <a href="~/User/UserProfileDetailsEdit?action=UserProfileDetailsUpdate&uaid=@userProfileDetailsItem.UserProfileDetailID"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                        <a href="#" onclick="DeleteUseProfileDetailsAndNotify(@userProfileDetailsItem.UserProfileDetailID,'@userProfileDetailsItem.ProfileName')"><i class="fas fa-trash" style="color:red;" data-toggle="tooltip" data-placement="right" title="Delete"></i></a>
                                    </td>
                                </tr>

                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!--#endregion Forms ends-->


@section scripts{
    <script>
        $(function () {
            $('.dynamic-scroable-table-module').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                paging: !1,
                "searching": false,
                "bPaginate": false,
                "bLengthChange": false,
                "bFilter": true,
                "bInfo": false,
                "bAutoWidth": false
            });
        });
        $(function () {
            $('.dynamic-table-action').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                responsive: true,
                lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ],
                drawCallback: function (e) {
                    var t = this.api(),
                        l = t.rows({
                            page: "current"
                        }).nodes(),
                        c = null;
                    t.column(1, {
                        page: "current"
                    }).data().each(function (e, t) {
                        c !== e && ($(l).eq(t).before('<tr class="group"><td colspan="5">' + e + "</td></tr>"), c = e)
                    })
                }
            });
        });

        function DeleteUseProfileAndNotify(id, value) {
            swal({
                title: "Are you sure?",
                text: "You want to delete " + value + " Module, all the related data will be deleted!",
                icon: "warning",
                closeOnEsc: false,
                closeOnClickOutside: false,
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        var data = {};
                        data.UserProfileID = id;
                        data.ProfileName = value;
                        $.ajax({
                            type: "POST",
                            url: "/User/UserProfileDelete",
                            dataType: "json",
                            data: JSON.stringify(data),
                            contentType: "application/json; charset=utf-8",
                            success: function (response) {
                                swal("Poof all gone! " + response, {
                                    icon: "success",
                                }).then(function () {
                                    window.location.href = "/User/UserProfile"
                                });
                            },
                            failure: function (response) {
                                alert(response.responseText);
                            },
                            error: function (response) {
                                alert(response.responseText);
                            }
                        });
                    }
                });
        }

        function DeleteUseProfileDetailsAndNotify(id, value) {
            swal({
                title: "Are you sure?",
                text: "You want to delete " + value + " Module, all the related data will be deleted!",
                icon: "warning",
                closeOnEsc: false,
                closeOnClickOutside: false,
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        var data = {};
                        data.UserProfileDetailID = id;
                        data.ProfileName = value;
                        $.ajax({
                            type: "POST",
                            url: "/User/UserProfileDetailsDelete",
                            dataType: "json",
                            data: JSON.stringify(data),
                            contentType: "application/json; charset=utf-8",
                            success: function (response) {
                                swal("Poof all gone! " + response, {
                                    icon: "success",
                                }).then(function () {
                                    window.location.href = "/User/UserProfile"
                                });
                            },
                            failure: function (response) {
                                alert(response.responseText);
                            },
                            error: function (response) {
                                alert(response.responseText);
                            }
                        });
                    }
                });
        }
    </script>
}
