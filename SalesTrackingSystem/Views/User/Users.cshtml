@using Services.Interface
@using Services.Service
@using Models;

@{
    Users_Interface users_ = new Users_Service();
}

@model Models.Users_Model

@{
    ViewBag.Title = "Users";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Page = "Users";
    ViewBag.AppName = "Tinjure tea factory";
    int SearialNumber = 1;
    ViewBag.ActionNameUser = "Add";
    ViewBag.ActionNameException = "Add";
}
@Html.Partial("~/Views/Shared/_Alert.cshtml")
<div class="row">
    <div class="col-12">
        <div class="overview-wrap">
            <div class="title-1">
                <h4><a href="">@ViewBag.AppName</a> > User > @ViewBag.Page</h4>
            </div>
        </div>
    </div>
    <br>
    <br>
</div>



@if (ViewBag.AddUserError != null)
{
    <script>
        window.onload = function () {
            $('#UsersAdd').slideDown();
        }
    </script>
}
@if (ViewBag.EditUserDropDown != null)
{
    <script>
        window.onload = function () {
            $('#UsersUpdate').slideDown();
        }
    </script>
}
@if (ViewBag.UpdateUserError != null)
{
    <script>
        window.onload = function () {
            $('#UsersUpdate').slideDown();
        }
    </script>
}

@if (ViewBag.AddExceptionError != null)
{
    <script>
        window.onload = function () {
            $('#ExceptionUsersAdd').slideDown();
        }
    </script>
}
<div class="row">
    @if (ViewBag.ActionNameUser == "Add")
    {
        @Html.Partial("Users_Add")
    }

    @if (Request.Params.Get("action") == "UserUpdate")
    {
        if (users_.UserExists(Convert.ToInt64(Request.Params.Get("uaid"))))
        {
            @Html.Partial("Users_Update", users_.GetModelById(Convert.ToInt64(Request.Params.Get("uaid"))));
        }
        else
        {
            Session["Error"] = " User couldn't be found please retry!!";
        }
    }

    @if (ViewBag.UpdateUserData != null)
    {
        Int64 uaid = Convert.ToInt64(ViewBag.UpdateUserData);
        if (users_.UserExists(uaid))
        {
            @Html.Partial("Users_Update", users_.GetModelById(uaid));
        }
        else
        {
            Session["Error"] = " User couldn't be found please retry!!";
        }
    }

    @if (ViewBag.ActionNameException == "Add")
    {
        @Html.Partial("ExceptionUser_Add")
    }
    <div class="col-sm-7">
        <div class="card">
            <div class="card-header">
                <strong> Users List</strong>
                <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" data-placement="left" title="Add User" onclick="javascript: $('#UsersAdd').slideDown()">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="dynamic-table table table-bordered table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th style="text-align: center;">SN</th>
                            <th style="text-align: center;">Profile</th>
                            <th style="text-align: center;">Name</th>
                            <th style="text-align: center;">Image</th>
                            <th style="text-align: center;">Email</th>
                            <th style="text-align: center;">User Status</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var UserItem in users_.DisplayTable())
                        {
                            if (users_.DisplayTable() != null)
                            {
                                <tr>
                                    <td style="text-align: center;">@(SearialNumber++)</td>
                                    <td style="text-align: center;">@UserItem.ProfileName</td>
                                    <td style="text-align: center;">@UserItem.FullName</td>
                                    <td style="text-align: center;"><img src="@(UserItem.ImageString==null?"Https://"+Request.ServerVariables["HTTP_HOST"]+"/images/icon/user.png":"Https://"+Request.ServerVariables["HTTP_HOST"]+UserItem.ImageString)"  alt="Not Found" style="max-height:50px; width:auto;" /></td>
                                    <td style="text-align: center;"><a href="mailto:@(UserItem.Email)">@UserItem.Email</a></td>
                                    <td style="text-align: center; color:@(UserItem.UsersStatus==0?"purple":UserItem.UsersStatus==1?"green":UserItem.UsersStatus==2?"blue":"red");"> <i class="fas fa-circle"></i> @(UserItem.UsersStatus == 0 ? "Not Verified" : UserItem.UsersStatus == 1 ? "Active" : UserItem.UsersStatus == 2 ? "Inactive" :  "Blocked")</td>
                                    <td style="padding-left:4%;">
                                        <a href="~/User/UserEdit?action=UserUpdate&uaid=@UserItem.UserID"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                        <a href="#" onclick="DeleteAndNotify(@UserItem.UserID,'@UserItem.FullName')"><i class="fas fa-trash" style="color:red;"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-sm-5">
        <div class="card">
            <div class="card-header">
                <strong> Individual access List</strong>
                <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" data-placement="left" title="Add individual access " onclick="javascript: $('#ExceptionUsersAdd').slideDown()">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>
            <div class="card-body card-block">
                <table class="dynamic-table-action table table-bordered table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th style="text-align: center;">SN</th>
                            <th style="text-align: center;">Full Name</th>
                            <th style="text-align: center;">Modul Name</th>
                            <th style="text-align: center;">Action Name</th>
                            <th style="text-align: center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="text-align: center;">1</td>
                            <td style="text-align: center;">Dibesh Raj Subedi</td>
                            <td style="text-align: center;">Login</td>
                            <td style="text-align: center;">Create</td>
                            <td style="padding-left:4%;">
                                <a href="#"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                <a href="#"><i class="fas fa-trash" style="color:red;" data-toggle="tooltip" data-placement="right" title="Delete"></i></a>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: center;">1</td>
                            <td style="text-align: center;">Dibesh Raj Subedi</td>
                            <td style="text-align: center;">Forget</td>
                            <td style="text-align: center;">Create</td>
                            <td style="padding-left:4%;">
                                <a href="#"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                <a href="#"><i class="fas fa-trash" style="color:red;" data-toggle="tooltip" data-placement="right" title="Delete"></i></a>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: center;">1</td>
                            <td style="text-align: center;">Dibesh Raj Subedi</td>
                            <td style="text-align: center;">Reset</td>
                            <td style="text-align: center;">Create</td>
                            <td style="padding-left:4%;">
                                <a href="#"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                <a href="#"><i class="fas fa-trash" style="color:red;" data-toggle="tooltip" data-placement="right" title="Delete"></i></a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script>
        $(function () {
            $('.dynamic-table').DataTable({
                responsive: true,
                lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ],

            });
        });
        $(function () {
            $('.dynamic-table-action').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                responsive: true,
                lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ],
                drawCallback: function (e) {
                    var t = this.api(),
                        l = t.rows({
                            page: "current"
                        }).nodes(),
                        c = null;
                    t.column(1, {
                        page: "current"
                    }).data().each(function (e, t) {
                        c !== e && ($(l).eq(t).before('<tr class="group"><td colspan="5">' + e + "</td></tr>"), c = e)
                    })
                }
            });
        });
        function DeleteAndNotify(id, value) {
            swal({
                title: "Are you sure?",
                text: "You want to delete " + value + " from User list, all the related data will be deleted!",
                icon: "warning",
                closeOnEsc: false,
                closeOnClickOutside: false,
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        var data = {};
                        data.UserID = id;
                        data.FullName = value;
                        $.ajax({
                            type: "POST",
                            url: "/User/UserDelete",
                            dataType: "json",
                            data: JSON.stringify(data),
                            contentType: "application/json; charset=utf-8",
                            success: function (response) {
                                swal("Poof all gone! " + response, {
                                    icon: "success",
                                }).then(function () {
                                    window.location.href = "/User/Users"
                                });
                            }
                        });
                    }
                });
        }
    </script>
}
