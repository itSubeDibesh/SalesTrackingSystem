<div class="col-12" id="ExceptionUsersAdd" style="display:none;">
    <div class="card">
        <div class="card-header">
            Add <strong>User</strong>
            <button class="btn btn-danger " style="float: right;" data-toggle="tooltip" data-placement="right" title="Close User Form" onclick=" $('#ExceptionUsersAdd').slideUp();">
                <i class="fas fa-close"></i>
            </button>
        </div>
        <div class="card-body">
            <div class="col-12">
                <form action="" method="post" enctype="multipart/form-data" class="form-horizontal">
                    <div class="row form-group">
                        <input type="hidden" name="UserID" value="2" />
                        <div class="col-md-3 col-sm-6">
                            <label for="text-input" class=" form-control-label">Full Name</label>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <input type="text" id="text-input" name="text-input" disabled value="Dibesh Raj Subedi" class="form-control">
                        </div>

                        <div class="col-md-3 col-sm-6">
                            <label for="email-input" class=" form-control-label">Module Name</label>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="select" id="select" class="form-control">
                                <option selected disabled>Please select</option>
                                <option value="active">Login</option>
                                <option value="inactive">Create</option>
                            </select>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            <label for="phone-input" class=" form-control-label">Action Name</label>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="select" id="select" class="form-control">
                                <option selected disabled>Please select</option>
                                <option value="active">Create</option>
                                <option value="inactive">Forget</option>
                            </select>
                        </div>

                        <div class="col-md-3 col-sm-6">
                            <label for="select" class=" form-control-label">Status</label>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <select name="select" id="select" class="form-control">
                                <option selected disabled>Please select</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="row form-group">
                        <div class="col-md-3 col-sm-6">
                            <label for="password-input" class=" form-control-label">Description</label>
                        </div>
                        <div class="col-md-9 col-sm-6">
                            <textarea name="textarea-input" id="textarea-input" rows="15" placeholder="Content..." class="form-control"></textarea>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="fa fa-paper-plane"></i> Submit
                        </button>
                        <button type="reset" class="btn btn-danger btn-sm">
                            <i class="fa fa-trash"></i> Reset
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
