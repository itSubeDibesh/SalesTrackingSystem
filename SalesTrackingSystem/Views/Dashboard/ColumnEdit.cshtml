@using Services.Interface
@using Services.Service
@using Models;

@{
    DashboardTable_Interface dashboardTable = new DashboardTable_Service();
}
@model Models.DashboardGivenColumn_Model
<div class="col-sm-12" id="ColumnUpdate" style="display:none;">
    <div class="card">
        <div class="card-header">
            <strong>Edit</strong> Column Name
            <a href="~/Dashboard/Settings" class="btn btn-danger " style="float: right;color:white;"><i class="fas fa-close"></i></a>
        </div>
        <div class="card-body card-block">
            @using (Html.BeginForm("ColumnUpdate", "Dashboard", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @Html.HiddenFor(model => model.DashboardGivenColumnId)
                <div class="row form-group">
                    <div class="col-md-3 col-sm-6">
                        @Html.LabelFor(model => model.ColumnName, htmlAttributes: new { @class = "form-control-label" })
                    </div>
                    <div class="col-md-3 col-sm-6">
                        @Html.EditorFor(model => model.ColumnName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ColumnName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-3 col-sm-6">
                        @Html.LabelFor(model => model.DashboardTableId, htmlAttributes: new { @class = "form-control-label" })
                    </div>
                    <div class="col-md-3 col-sm-6">
                        <select name="DashboardTableId" id="DashboardTableId" class="form-control">
                            <option selected disabled>Please select</option>
                            @foreach (var table in dashboardTable.DisplayTable())
                            {
                                if (dashboardTable.DisplayTable() != null)
                                {
                                    <option value="@table.DashboardTableId" @(Model.DashboardTableId == table.DashboardTableId ? "selected" : "")>@table.TableName</option>
                                }
                            }
                        </select>
                        @Html.ValidationMessageFor(model => model.DashboardTableId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-success btn-sm">
                        <i class="fa fa-save"></i> Save
                    </button>
                    <a href="~/Dashboard/Settings" class="btn btn-danger btn-sm" style="color:white;"><i class="fa fa-trash"></i> Reset</a>
                </div>
            </div>
            }
        </div>
    </div>
</div>