@model Models.DashboardType_Model
    <div class="col-sm-12" id="TypeAdd" style="display:none;">
        <div class="card">
            <div class="card-header">
                <strong>Add</strong> Type
                <button class="btn btn-danger " style="float: right;" onclick=" $('#TypeAdd').slideUp();">
                    <i class="fas fa-close"></i>
                </button>
            </div>
            <div class="card-body card-block">
                @using (Html.BeginForm("TypeAdd", "Dashboard", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-horizontal">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="row form-group">
                            <div class="col-md-3 col-sm-6">
                                @Html.LabelFor(model => model.TypeName, htmlAttributes: new { @class = "form-control-label" })
                            </div>
                            <div class="col-md-9 col-sm-6">
                                @Html.EditorFor(model => model.TypeName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.TypeName, "", new { @class = "text-danger" })
                            </div>                            
                        </div>
                       
                        <div class="card-footer">
                            <button type="submit" class="btn btn-success btn-sm">
                                <i class="fa fa-paper-plane"></i> Submit
                            </button>
                            <button type="reset" class="btn btn-danger btn-sm">
                                <i class="fa fa-trash"></i> Reset
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

