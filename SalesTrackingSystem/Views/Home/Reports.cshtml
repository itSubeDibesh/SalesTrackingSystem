@model Models.Users_Model
@using Models
@using Services.Interface
@using Services.Service
@using DataAccessLayer
@{
    var SessionVariable = new Users_Model();
    Int16 level=3;
    int SerialDisplay = 1;
    int SerialPrint = 1;

    if (Session["auth"] != null)
    {
        SessionVariable = (Session["auth"] as Users_Model);       
    }
    Transaction_Interface transaction_ = new Transaction_Service();
    Product_Interface product = new Product_Service();
    SalesTrackingSystemEntities entities = new SalesTrackingSystemEntities();
    Distributor_Interface distributor = new Distributor_Service();
    Reseller_Interface reseller = new Reseller_Service();
    Unit_Interface unit_ = new Unit_Service();
     if (SessionVariable != null)
        {
            if (SessionVariable.ProfileName == "Company")
            {
                /*Distributor to Reseller*/
                level = 1;
            } else if (SessionVariable.ProfileName == "Distributor") {
                /*Company to Distributor*/
                level = 2;
            }
            else
            {
                level = 0;
            }
        }
}
@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Page = "Reports";
}

<div class="row">
    <div class="col-sm-12 col-md-12 container">
        <div class="col-sm-12 card">
            <div class="container-fluid">
                <div class="card-header">
                    <strong>Reports</strong>
                </div>
                <div>
                    <div class="card-body card-block m-t-20">
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <p>
                                    <Strong>Date Generated: </Strong> &nbsp;@DateTime.Now.ToShortDateString()
                                </p>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <span>
                                    <img src="~/images/icon/logo.png" alt="Tinjure tea factory" style="min-height:54px; min-width:179px; max-height:52px;max-width:179px;" />
                                </span>
                            </div>

                            <div class="col-sm-12">
                                <br />
                                <h2 style="color:green; line-height:40px;">Report</h2><p>Tinjuri Tea factory</p>
                            </div>
                        </div>
                        <hr />
                        <div class="row m-t-20">
                            <div class="col-sm-12">
                                <div class="row">
                                    <div class="col-md-4 col-sm-12">
                                        <div class="row">
                                            <div class="col-4 col-sm-12">
                                                Year:
                                            </div>
                                            <div class="col-8 col-sm-12">
                                                <select name="Year" id="Year" class="form-control">
                                                    <option selected>Select Year</option>
                                                    @foreach (var item in entities.FetchDates())
                                                    {
                                                        if (item != null)
                                                        {
                                                             <option value="@item.Years">@item.Years</option>
                                                        }
                                                    }                                                  
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12">
                                        <div class="row">
                                            <div class="col-4 col-sm-12">
                                                Month:
                                            </div>
                                            <div class="col-8 col-sm-12">
                                                <select name="Month" id="Month" class="form-control">
                                                    <option value="Month" selected>Select Month</option>
                                                    @foreach (var item in entities.FetchDates())
                                                    {
                                                        if (item != null)
                                                        {
                                                            <option value="@item.Months">@item.Months</option>
                                                        }
                                                    }                                                 
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4 col-sm-12">
                                        <div class="row">
                                            <div class="col-4 col-sm-12">
                                                Product:
                                            </div>
                                            <div class="col-8">
                                                <select name="Product" id="Product" class="form-control">
                                                    <option value="Product" selected>Select Product</option>
                                                    @foreach (var item in product.ListAllData())
                                                    {
                                                        if (item != null)
                                                        {
                                                            <option value="@item.ProductName">@item.ProductName</option>
                                                        }
                                                    }                                                   
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />                     
                        <table id="Report_Table" class="table table-bordered table-hover" width="100%">
                            <thead class="thead-dark">
                                <tr>
                                    <th style="text-align: center;">SN</th>
                                    <th style="text-align: center;">Year</th>
                                    <th style="text-align: center;">Month</th>
                                    <th style="text-align: center;">Supplier</th>
                                    <th style="text-align: center;">Receiver</th>
                                    <th style="text-align: center;">Product</th>
                                    <th style="text-align: center;">Quantity</th>
                                    <th style="text-align: center;">Price</th>
                                    <th style="text-align: center;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in entities.FetchReport())
                                {
                                    if (item!=null)
                                    {
                                <tr>
                                    <td style="text-align: center;">@(SerialDisplay++)</td>
                                    <td style="text-align: center;">@item.Year</td>
                                    <td style="text-align: center;">@item.Month</td>
                                    <td style="text-align: center;">@(item.Level == 1 ? distributor.GetDistributorNameByID(Convert.ToInt64(item.Supplier)) +item.Receiver: "Tinjure Organic Tea")</td>
                                    <td style="text-align: center;">@(item.Level == 1 ? reseller.ResellerNameById(Convert.ToInt64(item.Receiver)) : distributor.GetDistributorNameByID(Convert.ToInt64(item.Receiver)))</td>
                                    <td style="text-align: center;">@product.GetProductNameById(Convert.ToInt64(item.ProductID))</td>
                                    <td style="text-align: center;">@item.Quantity @unit_.UnitAbbrById(Convert.ToInt64(item.UnitId))</td>
                                    <td style="text-align: center;">NRS @(string.Format("{0:#.00}", item.Balance / item.Quantity))/-</td>
                                    @{decimal discountAmountPrint = 0;
                                    decimal discountPercentPrint = 0;
                                    if (item.DiscountPercent != null)
                                    {
                                    discountAmountPrint = Convert.ToDecimal(((item.DiscountPercent) / 100) * item.Balance);
                                    discountPercentPrint = Convert.ToDecimal(item.DiscountPercent);
                                    }
                                    decimal taxPercentPrint = 13;
                                    if (item.TaxPercent != null)
                                    {
                                    taxPercentPrint = Convert.ToDecimal(item.TaxPercent);
                                    }

                                    var SubtotalPrint = item.Balance;
                                    var taxAmountPrint = ((SubtotalPrint - discountAmountPrint) / 100) * taxPercentPrint;
                                    var discountedValuePrint = SubtotalPrint - discountAmountPrint;
                                    var grandTotalPrint = taxAmountPrint + discountedValuePrint;}
                                <td style="text-align: center;">NRS @(string.Format("{0:#.00}", grandTotalPrint))/-</td>
                                </tr>
                                    }
                                }      
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="prinTingReport" class="d-none">
                    <div class="card-body card-block m-t-20">
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <p>
                                    <Strong>Date Generated: </Strong> 0&nbsp;@DateTime.Now.ToShortDateString()
                                </p>
                            </div>
                        </div>
                        <div class="row form-group">
                            <div class="col-sm-12">
                                <span>
                                    <img src="~/images/icon/logo.png" alt="Tinjure tea factory" style="min-height:54px; min-width:179px; max-height:52px;max-width:179px;" />
                                </span>
                            </div>

                            <div class="col-sm-12">
                                <br />
                                <h2 style="color:green; line-height:40px;">Report</h2><p>Tinjuri Tea factory</p>
                            </div>
                        </div>
                        <table id="Report_TablePrint" class="table table-bordered" width="100%">
                            <thead class="thead-dark">
                                <tr>
                                    <th style="text-align: center;">SN</th>
                                    <th style="text-align: center;">Year</th>
                                    <th style="text-align: center;">Month</th>
                                    <th style="text-align: center;">Supplier</th>
                                    <th style="text-align: center;">Receiver</th>
                                    <th style="text-align: center;">Product</th>
                                    <th style="text-align: center;">Quantity</th>
                                    <th style="text-align: center;">Price</th>
                                    <th style="text-align: center;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in entities.FetchReport())
                                {
                                    if (item != null)
                                    {
                                        <tr>
                                            <td style="text-align: center;">@(SerialDisplay++)</td>
                                            <td style="text-align: center;">@item.Year</td>
                                            <td style="text-align: center;">@item.Month</td>
                                            <td style="text-align: center;">@(item.Level == 1 ? distributor.GetDistributorNameByID(Convert.ToInt64(item.Supplier)) + item.Receiver : "Tinjure Organic Tea")</td>
                                            <td style="text-align: center;">@(item.Level == 1 ? reseller.ResellerNameById(Convert.ToInt64(item.Receiver)) : distributor.GetDistributorNameByID(Convert.ToInt64(item.Receiver)))</td>
                                            <td style="text-align: center;">@product.GetProductNameById(Convert.ToInt64(item.ProductID))</td>
                                            <td style="text-align: center;">@item.Quantity @unit_.UnitAbbrById(Convert.ToInt64(item.UnitId))</td>
                                            <td style="text-align: center;">NRS @(string.Format("{0:#.00}", item.Balance / item.Quantity))/-</td>
                                            @{decimal discountAmountPrint = 0;
                                                decimal discountPercentPrint = 0;
                                                if (item.DiscountPercent != null)
                                                {
                                                    discountAmountPrint = Convert.ToDecimal(((item.DiscountPercent) / 100) * item.Balance);
                                                    discountPercentPrint = Convert.ToDecimal(item.DiscountPercent);
                                                }
                                                decimal taxPercentPrint = 13;
                                                if (item.TaxPercent != null)
                                                {
                                                    taxPercentPrint = Convert.ToDecimal(item.TaxPercent);
                                                }

                                                var SubtotalPrint = item.Balance;
                                                var taxAmountPrint = ((SubtotalPrint - discountAmountPrint) / 100) * taxPercentPrint;
                                                var discountedValuePrint = SubtotalPrint - discountAmountPrint;
                                                var grandTotalPrint = taxAmountPrint + discountedValuePrint;}
                                            <td style="text-align: center;">NRS @(string.Format("{0:#.00}", grandTotalPrint))/-</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <a onclick="printDiv('prinTingReport')" class="btn btn-success btn-sm" style="color:white;">
                    <i class="fa fa-file-pdf bg-danger"></i> Save / <i class="fa fa-print"></i> Print
                </a>
            </div>
        </div>
    </div>
</div>

@if (SessionVariable.UserID != 0)
{
    @section scripts{
        <script>
            function printDiv(divName) {
                var printContents = document.getElementById(divName).innerHTML;
                var originalContents = document.body.innerHTML;
                document.body.innerHTML = printContents;
                window.print();
                document.body.innerHTML = originalContents;
            }

            $.fn.dataTable.ext.search.push(
                function (settings, data, dataIndex) {

                    if (settings.nTable.id === '#Report_Table') {
                        return true;
                    }

                    var Year = parseInt($('#Year').val(), 10);
                    var Month = $('#Month').val();
                    var Product = $('#Product').val();

                    var year = data[1];
                    var month = data[2];
                    var product = data[5];

                    if ((isNaN(Year) && Year == year) &&
                        (isNaN(Month) && Month == month) &&
                        (Year == year && Month == month) ||
                        (Year == year || Month == month && isNaN(Month) || Month == month) ||
                        (Year == year && Month == month || isNaN(Year) || Year == year) &&
                        (Year == year || Month == month && isNaN(Month) && Year == year) ||
                        (Year == year && Month == month || isNaN(Year) && Month == month) &&
                        (Year != year && Month == month) ||
                        (Year == year && Month != month) &&
                        (Year != year || Month == month) &&
                        (Year == year || Month != month) &&
                        (isNaN(Product) && Product == product) ||
                        (Year == year || Product == product || Month == month)
                    ) {
                        return true;
                    }

                    return false;
                }
            );

            $(document).ready(function () {
                var table = $('#Report_Table').DataTable({
                    "bInfo": false,
                     lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ]
                });
                var table2 = $('#Report_TablePrint').DataTable({
                    "searching": true,
                    "bPaginate": false,
                    "bLengthChange": false,
                    "bFilter": true,
                    "bInfo": false,
                    "bAutoWidth": false
                });

                // Event listener to the two range filtering inputs to redraw on input
                $('#Year,#Month,#Product').change(function () {
                    table.draw();
                    table2.draw();
                });
            });
          
        </script>
    }
}
