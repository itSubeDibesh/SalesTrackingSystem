@model Models.Users_Model
@using Models
@{
    var SessionVariable = new Users_Model();
    if (Session["auth"] != null)
    {
        SessionVariable = (Session["auth"] as Users_Model);
    }
}
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Page = "Dashboard";
}
<div class="row">
    <div class="col-md-12">
        <div class="overview-wrap">
            <h2 class="title-1">overview</h2>
        </div>
    </div>
</div>

<div class="row m-t-25">
    <div class="col-lg-6">
        <div class="au-card m-b-30">
            <div class="au-card-inner">
                <h3 class="title-2 m-b-40">
                    Transaction chart @DateTime.Now.Year
                </h3>
                <canvas id="Transaction"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="row">
            <div class="col-sm-6 col-lg-6">
                <div class="overview-item overview-item--c1">
                    <div class="overview__inner">
                        <div class="overview-box clearfix">
                            <div class="icon">
                                <i class="zmdi zmdi-storage"></i>
                            </div>
                            <div class="text p-b-20">
                                <h2 id="Categories"></h2>
                                <span>Categories</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-6">
                <div class="overview-item overview-item--c2">
                    <div class="overview__inner">
                        <div class="overview-box clearfix">
                            <div class="icon">
                                <i class="zmdi zmdi-truck"></i>
                            </div>
                            <div class="text p-b-20">
                                <h2 id="QuantitySold"></h2>
                                <span>Quantity Sold</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-6">
                <div class="overview-item overview-item--c3">
                    <div class="overview__inner">
                        <div class="overview-box clearfix">
                            <div class="icon">
                                <i class="zmdi zmdi-face"></i>
                            </div>
                            <div class="text p-b-20">
                                <h2 id="Distributors"></h2>
                                <span>Distributors</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-6">
                <div class="overview-item overview-item--c4">
                    <div class="overview__inner">
                        <div class="overview-box clearfix">
                            <div class="icon">
                                <i class="zmdi zmdi-store"></i>
                            </div>
                            <div class="text p-b-20">
                                <h2 id="StockLeft"></h2>
                                <span>Stock Left</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-6">
                <div class="overview-item overview-item--c1">
                    <div class="overview__inner">
                        <div class="overview-box clearfix">
                            <div class="icon">
                                <i class="zmdi zmdi-accounts-list"></i>
                            </div>
                            <div class="text p-b-20">
                                <h2 id="ActiveUsers"></h2>
                                <span>Active users</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-6">
                <div class="overview-item overview-item--c2">
                    <div class="overview__inner">
                        <div class="overview-box clearfix">
                            <div class="icon">
                                <i class="zmdi zmdi-accounts"><i class="zmdi zmdi-accounts"></i></i>
                            </div>
                            <div class="text p-b-20">
                                <h2 id="Resellers"></h2>
                                <span>Resellers</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-6">
                <div class="overview-item overview-item--c3">
                    <div class="overview__inner">
                        <div class="overview-box clearfix">
                            <div class="icon">
                                <i class="zmdi zmdi-shopping-cart"></i>
                            </div>
                            <div class="text p-b-20">
                                <h2 id="Products"></h2>
                                <span>Products</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-6">
                <div class="overview-item overview-item--c4">
                    <div class="overview__inner">
                        <div class="overview-box clearfix">
                            <div class="icon">
                                <i class="zmdi zmdi-storage"><i class="zmdi zmdi-storage"></i></i>
                            </div>
                            <div class="text p-b-20">
                                <h2 id="Sub-categories"></h2>
                                <span>Sub-categories</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="au-card recent-report">
            <div class="au-card-inner">
                <h3 class="title-2">
                    recent reports
                </h3>
                <div class="chart-info">
                    <div class="chart-info__left">
                        <div class="chart-note">
                            <span class="dot dot--blue"></span>
                            <span>Unit Price</span>
                        </div>
                        <div class="chart-note mr-0">
                            <span class="dot dot--green"></span>
                            <span>Products sold</span>
                        </div>
                    </div>
                    <div class="chart-info__right">
                        <div class="chart-statis">
                            <span class="index incre">
                                <i class="zmdi zmdi-long-arrow-up"></i>25%
                            </span>
                            <span class="label">Unit Price</span>
                        </div>
                        <div class="chart-statis mr-0">
                            <span class="index decre">
                                <i class="zmdi zmdi-long-arrow-down"></i>10%
                            </span>
                            <span class="label">Products sold</span>
                        </div>
                    </div>
                </div>
                <div class="recent-report__chart">
                    <canvas id="recent-rep-chart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-12">
        <div class="au-card m-b-30">
            <div class="au-card-inner">
                <h3 class="title-2 m-b-40">
                    Price Chart
                </h3>
                <canvas id="lineChart"></canvas>
            </div>
        </div>
    </div>
</div>
@if (SessionVariable.UserID != 0)
{
    @section scripts{
        <script>
            /* Over views */
            $(document).ready(function () {
                sendOverviewRequest();
                function sendOverviewRequest() {
                    $.ajax({
                        type: "GET",
                        url: "/Home/GetDashboardOverviews",
                        contentType: "application/json; charset=utf-8",
                        success: function (json) {
                            for (var i = 0; i < json.length; i++) {
                                document.getElementById("Categories").innerHTML = json[i].Categories;
                                document.getElementById("QuantitySold").innerHTML = json[i].QuantitySold;
                                document.getElementById("Distributors").innerHTML = json[i].Distributors;
                                document.getElementById("StockLeft").innerHTML = json[i].StockLeft;
                                document.getElementById("ActiveUsers").innerHTML = json[i].ActiveUsers;
                                document.getElementById("Resellers").innerHTML = json[i].Resellers;
                                document.getElementById("Products").innerHTML = json[i].Products;
                                document.getElementById("Sub-categories").innerHTML = json[i].SubCategories;
                            }
                        },
                        complete: function () {
                            setInterval(sendOverviewRequest, 60000);
                        }
                    })
                };
            });

             /* Transaction chart */
            try {
               
                var ctx = document.getElementById("Transaction");
                if (ctx) {
                    ctx.height = 205;
                    var myChart = new Chart(ctx, {
                        type: 'bar',
                        maintainAspectRatio: true,
                        responsive: true,
                        defaultFontFamily: 'Poppins',
                        data: {
                            labels: ["January", "February", "March", "April", "May", "June", "July","August", "September", "October", "November", "December"],
                            datasets: [
                                {
                                    label: "Quantity sold",
                                    data: [90,65, 59, 80, 81, 56, 55, 40,65, 59, 80, 81, 56],
                                    borderColor: "rgba(0, 123, 255, 0.9)",
                                    borderWidth: "0",
                                    backgroundColor: "rgba(0, 133, 155, 0.5)",
                                    fontFamily: "Poppins"
                                },
                                {
                                    label: "My Second dataset",
                                    data: [28, 48, 40, 19, 86, 27, 90,28, 48, 40, 19, 190],
                                    borderColor: "rgba(0,0,0,0.09)",
                                    borderWidth: "0",
                                    backgroundColor: "rgba(0,123,155,1)",
                                    fontFamily: "Poppins"
                                }
                            ]
                        },
                        options: {
                            legend: {
                                position: 'top',
                                labels: {
                                    fontFamily: 'Poppins'
                                }

                            },
                            scales: {
                                xAxes: [{
                                    ticks: {
                                        fontFamily: "Poppins",


                                    }
                                }],
                                yAxes: [{
                                    ticks: {
                                        beginAtZero: true,
                                        fontFamily: "Poppins"
                                    }
                                }]
                            }
                        }
                    });
                }


            } catch (error) {
                console.log(error);
            }
        </script>
    }
}



