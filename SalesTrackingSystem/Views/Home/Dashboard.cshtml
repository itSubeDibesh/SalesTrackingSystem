@section aboveMain{
    <div style="margin-top:5%;" class="modal fade" id="Additem" data-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title mb-3">Dashbord item</h4>
                    <a class=" btn-sm btn-danger close" style="float: right;" data-dismiss="modal">
                        <i class="fas fa-close" style="color:white;"></i>
                    </a>
                </div>
                @Html.Partial("DashboardAdd")
            </div>
        </div>
    </div>
}

@section scripts{
    <script>
        $("#DashboardTypeID").change(function () {
            var dashboardTypeID = $("#DashboardTypeID").val();
            if (dashboardTypeID == 1) {
                $("#ColumnSelect").slideUp();
            } else {
                $("#ColumnSelect").slideDown();
            }
        });

        $("body").on("click", "#btnAdd", function () {
            //Reference the Name and Country TextBoxes.
            var DashboardGivenColumnId = $("#DashboardGivenColumnId");
            var color = $("#color");

            //Get the reference of the Table's TBODY element.
            var tBody = $("#tableColumns > TBODY")[0];

            //Add Row.
            var row = tBody.insertRow(-1);

            //Add Name cell.
            var cell = $(row.insertCell(-1));
            cell.html(DashboardGivenColumnId.val());

            //Add Country cell.
            cell = $(row.insertCell(-1));
            cell.html(color.val());

            //Add Button cell.
            cell = $(row.insertCell(-1));
            var btnRemove = $("<input />");
            btnRemove.attr("type", "button");
            btnRemove.attr("onclick", "Remove(this);");
            btnRemove.val("Remove");
            cell.append(btnRemove);

            //Clear the TextBoxes.
            DashboardGivenColumnId.val("");
            color.val("");
        });

        function Remove(button) {
            //Determine the reference of the Row using the Button.
            var row = $(button).closest("TR");
            var name = $("TD", row).eq(0).html();
            //Get the reference of the Table.
            var table = $("#tableColumns")[0];
            //Delete the Table row using it's Index.
            table.deleteRow(row[0].rowIndex);
        };

        $("body").on("click", "#AddDashboard", function () {
            //Loop through the Table rows and build a JSON array.
            var AddDashboards = new Array();
            $("#tableColumns TBODY TR").each(function () {
                var row = $(this);
                var AddDashboard = {};
                AddDashboard.DashboardTableId = $("#DashboardTableId").val();
                AddDashboard.DashboardTableId = $("#DashboardTypeID").val();
                AddDashboard.DashboardTableId = $("#ShowInHome").val();
                AddDashboard.DashboardGivenColumnId = row.find("TD").eq(0).html();
                AddDashboard.color = row.find("TD").eq(1).html();
                AddDashboards.push(AddDashboard);
            });

            //Send the JSON array to Controller using AJAX.
            $.ajax({
                type: "POST",
                url: "/Home/Index",
                data: JSON.stringify(AddDashboard),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (r) {
                    alert(r + " record(s) inserted.");
                }
            });
        });

    </script>
}