@model Models.Users_Model

@{
    ViewBag.Title = "Reseller";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Page = "Reseller";
    ViewBag.AppName = "Tinjure tea factory";
    ViewBag.Action = "AddReseller";
    var SerialNumber = 1;


}
@using Services.Interface;
@using Services.Service;
@{
    Reseller_Interface resellerService = new Reseller_Service();
    Distributor_Interface distService = new Distributor_Service();
}

@Html.Partial("~/Views/Shared/_Alert.cshtml")
<div class="row">
    <div class="col-12">
        <div class="overview-wrap">
            <div class="title-1">
                <h4><a href="">@ViewBag.AppName</a> > @ViewBag.Page</h4>
            </div>
        </div>
        <br>
    </div>
</div>
<div class="row">
    @*Add Update Reseller*@
    @if (ViewBag.Action == "AddReseller")
    {
        @Html.Partial("AddReseller")
    }
    @if (Request.Params.Get("action") == "UpdateReseller")
    {
        if (resellerService.ResellerExist(Convert.ToInt64(Request.Params.Get("res"))))
        {
            @Html.Partial("EditReseller", resellerService.GetResellerById(Convert.ToInt64(Request.Params.Get("res"))));
        }
        else
        {
            Session["Error"] = " Reseller couldn't be found please retry!!";
        }
    }
    @if (ViewBag.UpdateResellerData != null)
    {
        Int64 resId = Convert.ToInt64(ViewBag.UpdateResellerData);
        if (resellerService.ResellerExist(resId))
        {
            @Html.Partial("EditReseller", resellerService.GetResellerById(resId));
        }
        else
        {
            Session["Error"] = " Reseller couldn't be found please retry!!";
        }
    }
    @*Add Update Reseller Ends*@

    <div class="col-sm-12 col-md-12">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <strong> Reseller List</strong>
                    <button class="btn btn-primary " style="float: right;" data-toggle="tooltip" onclick="$('#AddReseller').slideDown();" data-placement="left" title="Add Reseller">
                        <i class="fas fa-plus"></i> Add
                    </button>
                </div>
                <div class="card-body card-block">
                    <table class="dynamic-table-action table table-bordered table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th style="text-align: center;">SN</th>
                                <th style="text-align: center;">Reseller Name</th>
                                <th style="text-align: center;">Distributor Name</th>
                                <th style="text-align: center;">Owner Name</th>
                                <th style="text-align: center;">Mobile No</th>
                                <th style="text-align: center;">Email</th>
                                <th style="text-align: center;">Address</th>
                                <th style="text-align: center;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in resellerService.ListAllData())
                            {
                                <tr>
                                    <td style="text-align: center;">@(SerialNumber++)</td>
                                    <td style="text-align: center;">@item.ResellerName</td>
                                    <td style="text-align: center;">@item.DistrubitorName</td>
                                    <td style="text-align: center;">@item.OwnerName</td>
                                    <td style="text-align: center;">@item.Mobile</td>
                                    <td style="text-align: center;">@item.Email</td>
                                    <td style="text-align: center;">@item.Address</td>
                                    <td style="padding-left:4%;">
                                        <a href="~/Reseller/EditReseller?action=UpdateReseller&res=@item.ResellerID"> <i class="fas fa-edit" style="color:green;" data-toggle="tooltip" data-placement="left" title="Edit"></i></a> |
                                        <a href="#" onclick="DeleteAndNotify(@item.ResellerID,'@item.ResellerName')"><i class="fas fa-trash" style="color:red;" data-toggle="tooltip" data-placement="right" title="Delete"></i></a>
                                    </td>
                                </tr>

                            }

                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(function () {
            $('.dynamic-table-action').DataTable({
                responsive: !0,
                scrollY: "65vh",
                scrollCollapse: !0,
                responsive: true,
                lengthMenu: [
                    [5, 10, 25, 50, -1],
                    [5, 10, 25, 50, "All"]
                ],
                drawCallback: function (e) {
                    var t = this.api(),
                        l = t.rows({
                            page: "current"
                        }).nodes(),
                        c = null;
                    t.column(2, {
                        page: "current"
                    }).data().each(function (e, t) {
                        c !== e && ($(l).eq(t).before('<tr class="group"><td colspan="5">' + e + "</td></tr>"), c = e)
                    })
                }
            });
        });
        function DeleteAndNotify(id, value) {
            swal({
                title: "Are you sure?",
                text: "You want to delete " + value + " , all the related data will be deleted!",
                icon: "warning",
                closeOnEsc: false,
                closeOnClickOutside: false,
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        var data = {};
                        data.ResellerID = id;
                        data.ResellerName = value;
                        $.ajax({
                            type: "POST",
                            url: "/Reseller/DeleteReseller",
                            dataType: "json",
                            data: JSON.stringify(data),
                            contentType: "application/json; charset=utf-8",
                            success: function (response) {
                                swal("Poof all gone! " + response, {
                                    icon: "success",
                                }).then(function () {
                                    window.location.href = "/Reseller/Reseller"
                                });
                            },
                            failure: function (response) {
                                alert(response.responseText);
                            },
                            error: function (response) {
                                alert(response.responseText);
                            }
                        });
                    }
                });
        }
    </script>
}